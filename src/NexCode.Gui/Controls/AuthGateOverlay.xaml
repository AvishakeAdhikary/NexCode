<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="NexCode.Gui.Controls.AuthGateOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <Storyboard x:Name="FadeInStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="RootBorder"
                Storyboard.TargetProperty="Opacity"
                From="0.0"
                To="1.0"
                Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Border
        x:Name="RootBorder"
        Background="#B3010409">
        <Grid>
            <Border
                Width="640"
                MaxWidth="640"
                Padding="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource NexCode.Surface.Card}"
                BorderBrush="{ThemeResource NexCode.Border.Strong}"
                BorderThickness="1"
                CornerRadius="{StaticResource NexCode.CornerRadius.XL}">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <StackPanel Spacing="16">
                    <TextBlock
                        x:Name="TitleText"
                        Style="{StaticResource NexCode.HeaderL}"
                        Text="Microsoft sign-in required" />
                    <TextBlock
                        x:Name="BodyText"
                        Style="{StaticResource NexCode.Body}"
                        Foreground="{ThemeResource NexCode.Text.Secondary}"
                        Text="The helper must complete authentication before the main dashboard unlocks." />

                    <Border Style="{StaticResource NexCode.Card.Subtle}">
                        <StackPanel Spacing="6">
                            <TextBlock
                                Style="{StaticResource NexCode.Body}"
                                FontWeight="SemiBold"
                                Text="Authentication status" />
                            <TextBlock
                                x:Name="StatusText"
                                Style="{StaticResource NexCode.Body}"
                                Text="Waiting for helper state..." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource NexCode.Card.Subtle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ProgressRing
                                x:Name="EventStreamProgress"
                                Width="20"
                                Height="20"
                                VerticalAlignment="Top"
                                IsActive="False" />
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock
                                    Style="{StaticResource NexCode.Body}"
                                    FontWeight="SemiBold"
                                    Text="Helper event stream" />
                                <TextBlock
                                    x:Name="PollStatusText"
                                    Style="{StaticResource NexCode.Body}"
                                    Text="Connecting to the helper event stream..." />
                                <TextBlock
                                    x:Name="EventDetailText"
                                    Style="{StaticResource NexCode.Caption}"
                                    Text="The helper will push authentication changes here as they happen." />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button
                            x:Name="SignInButton"
                            Style="{StaticResource NexCode.Button.Primary}"
                            Click="SignIn_Click"
                            Content="Sign in with Microsoft" />
                        <Button
                            x:Name="RefreshButton"
                            Style="{StaticResource NexCode.Button.Secondary}"
                            Click="Refresh_Click"
                            Content="Refresh now" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
