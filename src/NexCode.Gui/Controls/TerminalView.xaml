<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="NexCode.Gui.Controls.TerminalView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wv2="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="6" ColumnSpacing="8" Background="{ThemeResource LayerFillColorAltBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Shell:" />
            <ComboBox x:Name="ShellComboBox" Grid.Column="1" SelectedIndex="0">
                <ComboBoxItem Content="pwsh" />
                <ComboBoxItem Content="powershell" />
                <ComboBoxItem Content="cmd" />
                <ComboBoxItem Content="gitbash" />
                <ComboBoxItem Content="wsl" />
            </ComboBox>
            <TextBlock x:Name="StatusTextBlock" Grid.Column="2" VerticalAlignment="Center" Opacity="0.72" Text="not started" />
            <Button x:Name="StartButton" Grid.Column="3" Content="Start" Click="StartButton_Click" />
            <Button x:Name="KillButton" Grid.Column="4" Content="Kill" Click="KillButton_Click" IsEnabled="False" />
        </Grid>

        <wv2:WebView2 x:Name="WebView" Grid.Row="1" />
    </Grid>
</UserControl>
