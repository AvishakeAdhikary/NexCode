<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="NexCode.Gui.Controls.MessageBubble"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NexCode.Gui.ViewModels"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid x:Name="RootGrid" Padding="0,4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            x:Name="UserBubble"
            Grid.Column="2"
            Padding="14,10"
            HorizontalAlignment="Right"
            MaxWidth="640"
            Background="{ThemeResource NexCode.Accent.Subtle}"
            BorderBrush="{ThemeResource NexCode.Border.Subtle}"
            BorderThickness="1"
            CornerRadius="14,14,4,14"
            Visibility="Collapsed">
            <TextBlock
                x:Name="UserContentText"
                Style="{StaticResource NexCode.Body}"
                Foreground="{ThemeResource NexCode.Text.Primary}" />
        </Border>

        <Border
            x:Name="AssistantBubble"
            Grid.Column="0"
            Padding="14,10"
            HorizontalAlignment="Left"
            MaxWidth="720"
            Background="{ThemeResource NexCode.Surface.Elevated}"
            BorderBrush="{ThemeResource NexCode.Border.Subtle}"
            BorderThickness="1"
            CornerRadius="14,14,14,4"
            Visibility="Collapsed">
            <RichTextBlock
                x:Name="AssistantContent"
                IsTextSelectionEnabled="True" />
        </Border>

        <Border
            x:Name="SystemBubble"
            Grid.Column="1"
            Padding="10,6"
            HorizontalAlignment="Center"
            Background="{ThemeResource NexCode.Surface.Subtle}"
            CornerRadius="999"
            Visibility="Collapsed">
            <TextBlock
                x:Name="SystemContentText"
                Style="{StaticResource NexCode.Caption}" />
        </Border>
    </Grid>
</UserControl>
