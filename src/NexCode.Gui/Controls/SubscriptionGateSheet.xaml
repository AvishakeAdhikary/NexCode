<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="NexCode.Gui.Controls.SubscriptionGateSheet"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <Storyboard x:Name="SlideUpStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="SheetTransform"
                Storyboard.TargetProperty="Y"
                From="64"
                To="0"
                Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="SheetBorder"
                Storyboard.TargetProperty="Opacity"
                From="0.0"
                To="1.0"
                Duration="0:0:0.22" />
        </Storyboard>
    </UserControl.Resources>

    <Border Background="#66010409" Padding="24">
        <Border
            x:Name="SheetBorder"
            MaxWidth="980"
            Padding="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="{ThemeResource NexCode.Surface.Card}"
            BorderBrush="{ThemeResource NexCode.Border.Strong}"
            BorderThickness="1"
            CornerRadius="{StaticResource NexCode.CornerRadius.XL}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="SheetTransform" Y="0" />
            </Border.RenderTransform>
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <StackPanel Spacing="16">
                <TextBlock
                    x:Name="TitleText"
                    Style="{StaticResource NexCode.HeaderM}"
                    Text="Upgrade required" />
                <TextBlock
                    x:Name="BodyText"
                    Style="{StaticResource NexCode.Body}"
                    Foreground="{ThemeResource NexCode.Text.Secondary}"
                    Text="This feature requires a higher NexCode tier." />

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource NexCode.Card.Subtle}">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource NexCode.Body}" FontWeight="SemiBold" Text="Free" />
                            <TextBlock Style="{StaticResource NexCode.Caption}" Text="1 concurrent session" />
                            <TextBlock Style="{StaticResource NexCode.Caption}" Text="No sandbox" />
                            <TextBlock Style="{StaticResource NexCode.Caption}" Text="Local execution only" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource NexCode.Card.Subtle}">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource NexCode.Body}" FontWeight="SemiBold" Text="Pro" />
                            <TextBlock Style="{StaticResource NexCode.Caption}" Text="5 concurrent sessions" />
                            <TextBlock Style="{StaticResource NexCode.Caption}" Text="Sandbox + remote execution" />
                            <TextBlock Style="{StaticResource NexCode.Caption}" Text="3 sub-agents per session" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource NexCode.Card.Subtle}">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource NexCode.Body}" FontWeight="SemiBold" Text="Team" />
                            <TextBlock Style="{StaticResource NexCode.Caption}" Text="20 concurrent sessions" />
                            <TextBlock Style="{StaticResource NexCode.Caption}" Text="Cloud execution included" />
                            <TextBlock Style="{StaticResource NexCode.Caption}" Text="10 sub-agents per session" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource NexCode.Card.Subtle}">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource NexCode.Body}" FontWeight="SemiBold" Text="Enterprise" />
                            <TextBlock Style="{StaticResource NexCode.Caption}" Text="Unlimited sessions" />
                            <TextBlock Style="{StaticResource NexCode.Caption}" Text="Unlimited sub-agents" />
                            <TextBlock Style="{StaticResource NexCode.Caption}" Text="All execution modes" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock
                    x:Name="StatusText"
                    Style="{StaticResource NexCode.Caption}"
                    Text="Use Restore purchases or one of the upgrade buttons." />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="UpgradeProButton"
                        Style="{StaticResource NexCode.Button.Primary}"
                        Click="UpgradePro_Click"
                        Content="Upgrade to Pro" />
                    <Button
                        x:Name="UpgradeTeamButton"
                        Style="{StaticResource NexCode.Button.Primary}"
                        Click="UpgradeTeam_Click"
                        Content="Upgrade to Team" />
                    <Button
                        Style="{StaticResource NexCode.Button.Secondary}"
                        Click="Restore_Click"
                        Content="Restore purchases" />
                    <Button
                        Style="{StaticResource NexCode.Button.Tertiary}"
                        Click="Dismiss_Click"
                        Content="Dismiss" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
