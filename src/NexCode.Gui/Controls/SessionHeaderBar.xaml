<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="NexCode.Gui.Controls.SessionHeaderBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NexCode.Gui.ViewModels"
    xmlns:controls="using:NexCode.Gui.Controls"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Border
        Padding="14,10"
        Background="{ThemeResource NexCode.Surface.Card}"
        BorderBrush="{ThemeResource NexCode.Border.Subtle}"
        BorderThickness="0,0,0,1">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Mode badge -->
            <Border
                x:Name="ModeBadge"
                Padding="10,4"
                CornerRadius="999"
                Background="{ThemeResource NexCode.Accent.Subtle}">
                <TextBlock
                    x:Name="ModeText"
                    Style="{StaticResource NexCode.Caption}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource NexCode.Accent.Primary}"
                    Text="Code" />
            </Border>

            <!-- Personality avatar -->
            <Border
                Grid.Column="1"
                Width="32" Height="32"
                CornerRadius="16"
                Background="{ThemeResource NexCode.Surface.Subtle}">
                <TextBlock
                    x:Name="PersonalityInitial"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="D" />
            </Border>

            <!-- Model switcher -->
            <controls:ModelSwitcherDropdown
                Grid.Column="2"
                x:Name="ModelSwitcher" />

            <!-- Execution segmented control -->
            <StackPanel
                Grid.Column="3"
                Orientation="Horizontal"
                Background="{ThemeResource NexCode.Surface.Subtle}"
                CornerRadius="{StaticResource NexCode.CornerRadius.M}"
                BorderBrush="{ThemeResource NexCode.Border.Subtle}"
                BorderThickness="1"
                Padding="2">
                <RadioButton x:Name="LocalRadio"
                             Style="{StaticResource NexCode.PillButton.Selected}"
                             Background="Transparent" BorderThickness="0"
                             GroupName="ExecutionMode"
                             Content="Local"
                             IsChecked="True"
                             Padding="10,4"
                             Checked="ExecutionMode_Checked"
                             Tag="Local" />
                <RadioButton x:Name="RemoteRadio"
                             Style="{StaticResource NexCode.PillButton}"
                             Background="Transparent" BorderThickness="0"
                             GroupName="ExecutionMode"
                             Content="Remote"
                             Padding="10,4"
                             Checked="ExecutionMode_Checked"
                             Tag="Remote" />
                <RadioButton x:Name="CloudRadio"
                             Style="{StaticResource NexCode.PillButton}"
                             Background="Transparent" BorderThickness="0"
                             GroupName="ExecutionMode"
                             Content="Cloud"
                             Padding="10,4"
                             Checked="ExecutionMode_Checked"
                             Tag="Cloud" />
            </StackPanel>

            <!-- Sandbox toggle -->
            <ToggleSwitch
                Grid.Column="5"
                x:Name="SandboxToggle"
                OffContent="Sandbox off"
                OnContent="Sandbox on"
                Toggled="Sandbox_Toggled" />

            <!-- Shell selector -->
            <ComboBox
                Grid.Column="6"
                x:Name="ShellCombo"
                MinWidth="120"
                SelectionChanged="ShellCombo_SelectionChanged">
                <ComboBoxItem Content="pwsh" />
                <ComboBoxItem Content="bash" />
                <ComboBoxItem Content="cmd" />
            </ComboBox>
        </Grid>
    </Border>
</UserControl>
