<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="NexCode.Gui.Controls.ClarifyQuestionCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NexCode.Gui.ViewModels"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Border Style="{StaticResource NexCode.Card.Elevated}" Translation="0,0,16">
        <StackPanel Spacing="14">
            <StackPanel Spacing="6">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE9CE;" FontSize="16" Foreground="{ThemeResource NexCode.Status.Info}" />
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource NexCode.HeaderS}"
                        Text="Quick clarification" />
                </Grid>
                <TextBlock
                    Style="{StaticResource NexCode.Body}"
                    FontStyle="Italic"
                    Foreground="{ThemeResource NexCode.Text.Secondary}"
                    Text="{x:Bind ViewModel.Context, Mode=OneWay}" />
            </StackPanel>

            <ItemsRepeater
                x:Name="QuestionsHost"
                ItemsSource="{x:Bind ViewModel.Questions, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="14" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:ClarifyQuestionItemVM">
                        <StackPanel Spacing="8">
                            <TextBlock
                                Style="{StaticResource NexCode.Body}"
                                FontWeight="SemiBold"
                                Text="{x:Bind Prompt, Mode=OneWay}" />
                            <ItemsRepeater ItemsSource="{x:Bind Options}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="8" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ClarifyOptionItemVM">
                                        <ToggleButton
                                            Content="{x:Bind Label, Mode=OneWay}"
                                            IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                            Padding="14,6"
                                            CornerRadius="999"
                                            BorderThickness="1"
                                            MinHeight="32" />
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                            <Button
                                Style="{StaticResource NexCode.Button.Tertiary}"
                                Click="ToggleCustom_Click"
                                Tag="{x:Bind}"
                                Visibility="{x:Bind GetCustomToggleVisibility(AllowCustom)}"
                                Content="Other..." />
                            <TextBox
                                PlaceholderText="Type your answer..."
                                Text="{x:Bind CustomText, Mode=TwoWay}"
                                Visibility="{x:Bind GetExpandedVisibility(CustomExpanded), Mode=OneWay}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    Style="{StaticResource NexCode.Button.Primary}"
                    Content="Submit"
                    Command="{x:Bind ViewModel.SubmitCommand}"
                    IsEnabled="{x:Bind ViewModel.CanSubmit, Mode=OneWay}" />
                <Button
                    Style="{StaticResource NexCode.Button.Secondary}"
                    Content="Skip all"
                    Command="{x:Bind ViewModel.SkipAllCommand}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
