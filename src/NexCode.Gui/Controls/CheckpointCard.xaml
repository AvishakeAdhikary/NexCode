<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="NexCode.Gui.Controls.CheckpointCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NexCode.Gui.ViewModels"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Border Style="{StaticResource NexCode.Card.Surface}">
        <StackPanel Spacing="10">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE81C;" FontSize="16" Foreground="{ThemeResource NexCode.Status.Info}" />
                <TextBlock
                    Grid.Column="1"
                    Style="{StaticResource NexCode.HeaderS}"
                    Text="Checkpoint" />
                <Border
                    Grid.Column="2"
                    Style="{StaticResource NexCode.Badge}">
                    <TextBlock
                        Style="{StaticResource NexCode.Code}"
                        FontSize="12"
                        Text="{x:Bind ViewModel.ShortHash, Mode=OneWay}" />
                </Border>
            </Grid>

            <TextBlock
                Style="{StaticResource NexCode.Body}"
                Text="{x:Bind ViewModel.DiffSummary, Mode=OneWay}" />

            <ItemsRepeater ItemsSource="{x:Bind ViewModel.FilesChanged, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="6" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border Style="{StaticResource NexCode.Badge}">
                            <TextBlock Style="{StaticResource NexCode.Caption}" Text="{x:Bind}" />
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    Style="{StaticResource NexCode.Button.Secondary}"
                    Command="{x:Bind ViewModel.ViewDiffCommand}"
                    Content="View diff" />
                <Button
                    Style="{StaticResource NexCode.Button.Secondary}"
                    Command="{x:Bind ViewModel.RevertCommand}"
                    Content="Revert" />
                <Button
                    Style="{StaticResource NexCode.Button.Secondary}"
                    Command="{x:Bind ViewModel.ContinueFromHereCommand}"
                    Content="Continue from here" />
                <Button
                    Style="{StaticResource NexCode.Button.Secondary}"
                    Command="{x:Bind ViewModel.RetryCommand}"
                    Content="Retry" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
