<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="NexCode.Gui.Controls.TodoArtifactCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NexCode.Gui.ViewModels"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Border Style="{StaticResource NexCode.Card.Elevated}">
        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE762;" FontSize="16" Foreground="{ThemeResource NexCode.Accent.Primary}" />
                <TextBlock
                    Grid.Column="1"
                    Style="{StaticResource NexCode.HeaderS}"
                    Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
                <Button
                    Grid.Column="2"
                    Style="{StaticResource NexCode.Button.Tertiary}"
                    Click="OpenInPlans_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE8A7;" />
                        <TextBlock Text="Open in Plans" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Progress -->
            <StackPanel Grid.Row="1" Spacing="6">
                <ProgressBar
                    Value="{x:Bind ViewModel.ProgressFraction, Mode=OneWay}"
                    Maximum="1.0"
                    Foreground="{ThemeResource NexCode.Accent.Primary}" />
                <TextBlock
                    Style="{StaticResource NexCode.Caption}"
                    Text="{x:Bind ViewModel.Progress, Mode=OneWay}" />
            </StackPanel>

            <!-- Items -->
            <ItemsRepeater
                Grid.Row="2"
                x:Name="ItemsHost"
                ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="4" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:TodoItemViewModel">
                        <Grid
                            Padding="8,6"
                            ColumnSpacing="10"
                            Background="Transparent"
                            CornerRadius="{StaticResource NexCode.CornerRadius.S}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                FontSize="14"
                                Glyph="{x:Bind GlyphForStatus, Mode=OneWay}"
                                Foreground="{ThemeResource NexCode.Text.Secondary}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource NexCode.Body}"
                                Text="{x:Bind Text, Mode=OneWay}" />
                            <CheckBox
                                Grid.Column="2"
                                MinWidth="24"
                                IsChecked="{x:Bind IsDone, Mode=TwoWay}" />
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!-- Show all toggle -->
            <Button
                Grid.Row="3"
                x:Name="ShowAllButton"
                Style="{StaticResource NexCode.Button.Tertiary}"
                Click="ShowAll_Click"
                Content="Show all tasks"
                Visibility="Collapsed" />

            <!-- Add task -->
            <Grid Grid.Row="4" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="NewTaskBox"
                    PlaceholderText="Add a task"
                    KeyDown="NewTaskBox_KeyDown" />
                <Button
                    Grid.Column="1"
                    Style="{StaticResource NexCode.Button.Secondary}"
                    Click="AddTask_Click">
                    <FontIcon FontSize="12" Glyph="&#xE710;" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
