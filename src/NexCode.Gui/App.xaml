<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="NexCode.Gui.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NexCode.Gui"
    xmlns:infra="using:NexCode.Gui.Infrastructure">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Resources/Colors.xaml" />
                <ResourceDictionary Source="ms-appx:///Resources/Spacing.xaml" />
                <ResourceDictionary Source="ms-appx:///Resources/Typography.xaml" />
                <ResourceDictionary Source="ms-appx:///Resources/CardStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Shared converters -->
            <infra:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <infra:PlanArtifactConverter x:Key="PlanArtifactConverter" />
            <infra:TodoArtifactConverter x:Key="TodoArtifactConverter" />
            <infra:ClarifyArtifactConverter x:Key="ClarifyArtifactConverter" />
            <infra:CheckpointArtifactConverter x:Key="CheckpointArtifactConverter" />
            <infra:PermissionArtifactConverter x:Key="PermissionArtifactConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
