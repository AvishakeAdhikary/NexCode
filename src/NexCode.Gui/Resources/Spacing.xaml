<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 8px baseline grid spacing tokens -->
    <x:Double x:Key="NexCode.Spacing.XS">4</x:Double>
    <x:Double x:Key="NexCode.Spacing.S">8</x:Double>
    <x:Double x:Key="NexCode.Spacing.M">12</x:Double>
    <x:Double x:Key="NexCode.Spacing.L">16</x:Double>
    <x:Double x:Key="NexCode.Spacing.XL">24</x:Double>
    <x:Double x:Key="NexCode.Spacing.XXL">32</x:Double>

    <!-- Pre-built Thickness values for common usage patterns -->
    <Thickness x:Key="NexCode.Padding.XS">4</Thickness>
    <Thickness x:Key="NexCode.Padding.S">8</Thickness>
    <Thickness x:Key="NexCode.Padding.M">12</Thickness>
    <Thickness x:Key="NexCode.Padding.L">16</Thickness>
    <Thickness x:Key="NexCode.Padding.XL">24</Thickness>
    <Thickness x:Key="NexCode.Padding.XXL">32</Thickness>

    <!-- Corner radius tokens -->
    <CornerRadius x:Key="NexCode.CornerRadius.S">4</CornerRadius>
    <CornerRadius x:Key="NexCode.CornerRadius.M">8</CornerRadius>
    <CornerRadius x:Key="NexCode.CornerRadius.L">12</CornerRadius>
    <CornerRadius x:Key="NexCode.CornerRadius.XL">16</CornerRadius>

    <!-- Numeric corner radius tokens for controls that need doubles -->
    <x:Double x:Key="NexCode.CornerRadius.S.Value">4</x:Double>
    <x:Double x:Key="NexCode.CornerRadius.M.Value">8</x:Double>
    <x:Double x:Key="NexCode.CornerRadius.L.Value">12</x:Double>
    <x:Double x:Key="NexCode.CornerRadius.XL.Value">16</x:Double>
</ResourceDictionary>
