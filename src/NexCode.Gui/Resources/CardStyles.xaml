<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ThemeShadow x:Key="NexCode.CardShadow" />

    <!-- Card surfaces -->
    <Style x:Key="NexCode.Card.Surface" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource NexCode.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{ThemeResource NexCode.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource NexCode.CornerRadius.L}" />
        <Setter Property="Padding" Value="{StaticResource NexCode.Padding.L}" />
    </Style>

    <Style x:Key="NexCode.Card.Elevated" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource NexCode.Surface.Elevated}" />
        <Setter Property="BorderBrush" Value="{ThemeResource NexCode.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource NexCode.CornerRadius.L}" />
        <Setter Property="Padding" Value="{StaticResource NexCode.Padding.L}" />
        <Setter Property="Shadow" Value="{StaticResource NexCode.CardShadow}" />
    </Style>

    <Style x:Key="NexCode.Card.Subtle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource NexCode.Surface.Subtle}" />
        <Setter Property="BorderBrush" Value="{ThemeResource NexCode.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource NexCode.CornerRadius.M}" />
        <Setter Property="Padding" Value="{StaticResource NexCode.Padding.M}" />
    </Style>

    <!-- Buttons -->
    <Style x:Key="NexCode.Button.Primary" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="CornerRadius" Value="{StaticResource NexCode.CornerRadius.M}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="NexCode.Button.Secondary" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource NexCode.Surface.Elevated}" />
        <Setter Property="BorderBrush" Value="{ThemeResource NexCode.Border.Strong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource NexCode.Text.Primary}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="CornerRadius" Value="{StaticResource NexCode.CornerRadius.M}" />
    </Style>

    <Style x:Key="NexCode.Button.Tertiary" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource NexCode.Accent.Primary}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="CornerRadius" Value="{StaticResource NexCode.CornerRadius.M}" />
    </Style>

    <Style x:Key="NexCode.Button.Danger" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource NexCode.Status.Error}" />
        <Setter Property="BorderBrush" Value="{ThemeResource NexCode.Status.Error}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="CornerRadius" Value="{StaticResource NexCode.CornerRadius.M}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Pill button used for MCQ inputs -->
    <Style x:Key="NexCode.PillButton" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource NexCode.Surface.Subtle}" />
        <Setter Property="BorderBrush" Value="{ThemeResource NexCode.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource NexCode.Text.Primary}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="NexCode.PillButton.Selected" TargetType="Button" BasedOn="{StaticResource NexCode.PillButton}">
        <Setter Property="Background" Value="{ThemeResource NexCode.Accent.Subtle}" />
        <Setter Property="BorderBrush" Value="{ThemeResource NexCode.Accent.Primary}" />
        <Setter Property="Foreground" Value="{ThemeResource NexCode.Accent.Primary}" />
    </Style>

    <!-- Badge style for status pills -->
    <Style x:Key="NexCode.Badge" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource NexCode.Surface.Subtle}" />
        <Setter Property="BorderBrush" Value="{ThemeResource NexCode.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="8,2" />
    </Style>
</ResourceDictionary>
