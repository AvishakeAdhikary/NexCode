<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <!-- Default (Dark) -->
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="NexCode.Surface.Background" Color="#0E1116" />
            <SolidColorBrush x:Key="NexCode.Surface.Card" Color="#161B22" />
            <SolidColorBrush x:Key="NexCode.Surface.Elevated" Color="#1C2129" />
            <SolidColorBrush x:Key="NexCode.Surface.Subtle" Color="#11151B" />

            <SolidColorBrush x:Key="NexCode.Border.Subtle" Color="#22262D" />
            <SolidColorBrush x:Key="NexCode.Border.Strong" Color="#30363D" />

            <SolidColorBrush x:Key="NexCode.Text.Primary" Color="#E6EDF3" />
            <SolidColorBrush x:Key="NexCode.Text.Secondary" Color="#9DA7B3" />
            <SolidColorBrush x:Key="NexCode.Text.Tertiary" Color="#6A7584" />

            <SolidColorBrush x:Key="NexCode.Status.Success" Color="#3FB950" />
            <SolidColorBrush x:Key="NexCode.Status.Warning" Color="#D29922" />
            <SolidColorBrush x:Key="NexCode.Status.Error" Color="#F85149" />
            <SolidColorBrush x:Key="NexCode.Status.Info" Color="#58A6FF" />

            <SolidColorBrush x:Key="NexCode.Accent.Primary" Color="#2F81F7" />
            <SolidColorBrush x:Key="NexCode.Accent.Subtle" Color="#1F2D44" />
            <SolidColorBrush x:Key="NexCode.Accent.Hover" Color="#388BFD" />
            <SolidColorBrush x:Key="NexCode.Accent.Press" Color="#1F6FEB" />
        </ResourceDictionary>

        <!-- Light -->
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="NexCode.Surface.Background" Color="#F6F8FA" />
            <SolidColorBrush x:Key="NexCode.Surface.Card" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NexCode.Surface.Elevated" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NexCode.Surface.Subtle" Color="#EDEFF3" />

            <SolidColorBrush x:Key="NexCode.Border.Subtle" Color="#D0D7DE" />
            <SolidColorBrush x:Key="NexCode.Border.Strong" Color="#AFB8C1" />

            <SolidColorBrush x:Key="NexCode.Text.Primary" Color="#1F2328" />
            <SolidColorBrush x:Key="NexCode.Text.Secondary" Color="#57606A" />
            <SolidColorBrush x:Key="NexCode.Text.Tertiary" Color="#848D97" />

            <SolidColorBrush x:Key="NexCode.Status.Success" Color="#1A7F37" />
            <SolidColorBrush x:Key="NexCode.Status.Warning" Color="#9A6700" />
            <SolidColorBrush x:Key="NexCode.Status.Error" Color="#CF222E" />
            <SolidColorBrush x:Key="NexCode.Status.Info" Color="#0969DA" />

            <SolidColorBrush x:Key="NexCode.Accent.Primary" Color="#0969DA" />
            <SolidColorBrush x:Key="NexCode.Accent.Subtle" Color="#DDF4FF" />
            <SolidColorBrush x:Key="NexCode.Accent.Hover" Color="#0860C7" />
            <SolidColorBrush x:Key="NexCode.Accent.Press" Color="#0757BA" />
        </ResourceDictionary>

        <!-- High Contrast -->
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="NexCode.Surface.Background" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NexCode.Surface.Card" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NexCode.Surface.Elevated" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NexCode.Surface.Subtle" Color="{ThemeResource SystemColorWindowColor}" />

            <SolidColorBrush x:Key="NexCode.Border.Subtle" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NexCode.Border.Strong" Color="{ThemeResource SystemColorWindowTextColor}" />

            <SolidColorBrush x:Key="NexCode.Text.Primary" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NexCode.Text.Secondary" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NexCode.Text.Tertiary" Color="{ThemeResource SystemColorGrayTextColor}" />

            <SolidColorBrush x:Key="NexCode.Status.Success" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NexCode.Status.Warning" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NexCode.Status.Error" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="NexCode.Status.Info" Color="{ThemeResource SystemColorHighlightColor}" />

            <SolidColorBrush x:Key="NexCode.Accent.Primary" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NexCode.Accent.Subtle" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NexCode.Accent.Hover" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NexCode.Accent.Press" Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
