<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NexCode.Gui.Pages.PluginsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NexCode.Gui.ViewModels.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Foreground="{StaticResource NexCode.Text.Primary}"
                Text="Plugins" />
            <TextBlock
                Foreground="{StaticResource NexCode.Text.Secondary}"
                Text="Browse the marketplace and manage installed plugins." />
        </StackPanel>

        <TabView Grid.Row="1" IsAddTabButtonVisible="False">
            <TabViewItem Header="Installed" IsClosable="False">
                <Grid Margin="0,8,0,0" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Padding="0"
                        Background="{StaticResource NexCode.Surface.Card}"
                        BorderBrush="{StaticResource NexCode.Border.Subtle}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <ListView
                            x:Name="InstalledListView"
                            ItemsSource="{x:Bind ViewModel.Plugins, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedPlugin, Mode=TwoWay}"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:PluginRowViewModel">
                                    <StackPanel Padding="10,6">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Name, Mode=OneWay}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{StaticResource NexCode.Text.Secondary}"
                                            Text="{x:Bind Version, Mode=OneWay}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Padding="16"
                        Background="{StaticResource NexCode.Surface.Card}"
                        BorderBrush="{StaticResource NexCode.Border.Subtle}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel
                                DataContext="{x:Bind ViewModel.SelectedPlugin, Mode=OneWay}"
                                Spacing="10">
                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                <TextBlock Foreground="{StaticResource NexCode.Text.Secondary}" Text="{Binding Version}" />
                                <TextBlock Foreground="{StaticResource NexCode.Text.Secondary}" Text="{Binding Author}" />
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                <Border
                                    Padding="10"
                                    Background="{StaticResource NexCode.Surface.Subtle}"
                                    CornerRadius="8">
                                    <StackPanel Spacing="6">
                                        <TextBlock FontWeight="SemiBold" Text="Hooks &amp; permissions" />
                                        <TextBlock Text="{Binding Permissions}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <ToggleSwitch
                                    Header="Enabled"
                                    IsOn="{Binding IsEnabled, Mode=TwoWay}"
                                    Toggled="EnabledToggle_Toggled" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Marketplace" IsClosable="False">
                <Grid Margin="0,8,0,0">
                    <Border
                        Padding="20"
                        Background="{StaticResource NexCode.Surface.Card}"
                        BorderBrush="{StaticResource NexCode.Border.Subtle}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Spacing="8">
                            <TextBlock FontWeight="SemiBold" Text="Marketplace" />
                            <TextBlock
                                Foreground="{StaticResource NexCode.Text.Secondary}"
                                Text="A WebView2-hosted marketplace will appear here once the marketplace.nexcode.app surface ships." />
                            <Button Content="Open marketplace in browser" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabViewItem>
        </TabView>
    </Grid>
</Page>
