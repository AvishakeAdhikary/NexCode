<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NexCode.Gui.Pages.PlansPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NexCode.Gui.ViewModels.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Foreground="{StaticResource NexCode.Text.Primary}"
                Text="Plans" />
            <TextBlock
                Foreground="{StaticResource NexCode.Text.Secondary}"
                Text="Plans the agent has produced. Confirm a plan to start its todo list, or request changes." />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Padding="0"
                Background="{StaticResource NexCode.Surface.Card}"
                BorderBrush="{StaticResource NexCode.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="12">
                <ListView
                    x:Name="PlansListView"
                    ItemsSource="{x:Bind ViewModel.Plans, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedPlan, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlanRowViewModel">
                            <StackPanel Padding="12,8" Spacing="2">
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Title, Mode=OneWay}" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{StaticResource NexCode.Text.Secondary}"
                                        Text="{x:Bind Status, Mode=OneWay}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{StaticResource NexCode.Text.Tertiary}"
                                        Text="{x:Bind UpdatedAt, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Border
                Grid.Column="1"
                Padding="16"
                Background="{StaticResource NexCode.Surface.Card}"
                BorderBrush="{StaticResource NexCode.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{x:Bind ViewModel.ConfirmCommand}" Content="Confirm plan" />
                        <Button Command="{x:Bind ViewModel.RequestChangesCommand}" Content="Request changes" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Border
                            Padding="14"
                            Background="{StaticResource NexCode.Surface.Subtle}"
                            BorderBrush="{StaticResource NexCode.Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <TextBlock
                                FontFamily="Consolas"
                                FontSize="13"
                                Text="{x:Bind ViewModel.DetailMarkdown, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </Border>
                    </ScrollViewer>

                    <Border
                        Grid.Row="2"
                        Padding="10"
                        Background="{StaticResource NexCode.Surface.Subtle}"
                        BorderBrush="{StaticResource NexCode.Border.Subtle}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <TextBlock
                            FontSize="12"
                            Foreground="{StaticResource NexCode.Text.Secondary}"
                            Text="Plan editor placeholder. Slice 0015 swaps this preview for a Markdown live editor." />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <TextBlock
            Grid.Row="2"
            Foreground="{StaticResource NexCode.Text.Secondary}"
            Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
    </Grid>
</Page>
