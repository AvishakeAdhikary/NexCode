<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NexCode.Gui.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NexCode.Gui.ViewModels.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Foreground="{StaticResource NexCode.Text.Primary}"
                Text="History" />
            <TextBlock
                Foreground="{StaticResource NexCode.Text.Secondary}"
                Text="Searchable archive of past sessions across projects." />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox
                PlaceholderText="Full-text search..."
                QueryIcon="Find"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox
                Grid.Column="1"
                PlaceholderText="Project"
                SelectedItem="{x:Bind ViewModel.ProjectFilter, Mode=TwoWay}" />
            <ComboBox
                Grid.Column="2"
                PlaceholderText="Mode"
                SelectedItem="{x:Bind ViewModel.ModeFilter, Mode=TwoWay}" />
            <ComboBox
                Grid.Column="3"
                PlaceholderText="Provider"
                SelectedItem="{x:Bind ViewModel.ProviderFilter, Mode=TwoWay}" />
            <ComboBox
                Grid.Column="4"
                ItemsSource="{x:Bind ViewModel.DateFilters}"
                PlaceholderText="Date"
                SelectedItem="{x:Bind ViewModel.DateFilter, Mode=TwoWay}" />
            <Button
                Grid.Column="5"
                Command="{x:Bind ViewModel.SearchCommand}"
                Content="Search" />
        </Grid>

        <Border
            Grid.Row="2"
            Padding="0"
            Background="{StaticResource NexCode.Surface.Card}"
            BorderBrush="{StaticResource NexCode.Border.Subtle}"
            BorderThickness="1"
            CornerRadius="12">
            <ListView
                x:Name="SessionsListView"
                ItemsSource="{x:Bind ViewModel.Sessions, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedSession, Mode=TwoWay}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SessionHistoryRowViewModel">
                        <Grid Padding="12,10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Title, Mode=OneWay}" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{StaticResource NexCode.Text.Secondary}"
                                    Text="{x:Bind Project, Mode=OneWay}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind Mode, Mode=OneWay}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Provider, Mode=OneWay}" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Personality, Mode=OneWay}" />
                            <TextBlock
                                Grid.Column="4"
                                Foreground="{StaticResource NexCode.Text.Secondary}"
                                Text="{x:Bind UpdatedAt, Mode=OneWay}" />
                            <StackPanel
                                Grid.Column="5"
                                Orientation="Horizontal"
                                Spacing="4">
                                <Button
                                    Command="{Binding ElementName=SessionsListView, Path=DataContext.OpenCommand}"
                                    CommandParameter="{x:Bind}"
                                    Content="Open" />
                                <Button
                                    Command="{Binding ElementName=SessionsListView, Path=DataContext.RenameCommand}"
                                    CommandParameter="{x:Bind}"
                                    Content="Rename" />
                                <Button
                                    Command="{Binding ElementName=SessionsListView, Path=DataContext.ArchiveCommand}"
                                    CommandParameter="{x:Bind}"
                                    Content="Archive" />
                                <Button
                                    Command="{Binding ElementName=SessionsListView, Path=DataContext.ExportJsonCommand}"
                                    CommandParameter="{x:Bind}"
                                    Content="JSON" />
                                <Button
                                    Command="{Binding ElementName=SessionsListView, Path=DataContext.ExportMarkdownCommand}"
                                    CommandParameter="{x:Bind}"
                                    Content="MD" />
                                <Button
                                    Command="{Binding ElementName=SessionsListView, Path=DataContext.DeleteCommand}"
                                    CommandParameter="{x:Bind}"
                                    Content="Delete" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <TextBlock
            Grid.Row="3"
            Foreground="{StaticResource NexCode.Text.Secondary}"
            Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
    </Grid>
</Page>
