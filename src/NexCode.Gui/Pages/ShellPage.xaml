<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NexCode.Gui.Pages.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NexCode.Gui.ViewModels"
    xmlns:controls="using:NexCode.Gui.Controls"
    xmlns:infra="using:NexCode.Gui.Infrastructure"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent">

    <Page.Resources>
        <!-- Per-kind message templates -->
        <DataTemplate x:Key="TextMessageTemplate" x:DataType="vm:MessageViewModel">
            <controls:MessageBubble Message="{x:Bind}" />
        </DataTemplate>
        <DataTemplate x:Key="PlanMessageTemplate" x:DataType="vm:MessageViewModel">
            <controls:PlanArtifactCard ViewModel="{x:Bind Artifact, Converter={StaticResource PlanArtifactConverter}, Mode=OneWay}" />
        </DataTemplate>
        <DataTemplate x:Key="TodoMessageTemplate" x:DataType="vm:MessageViewModel">
            <controls:TodoArtifactCard ViewModel="{x:Bind Artifact, Converter={StaticResource TodoArtifactConverter}, Mode=OneWay}" />
        </DataTemplate>
        <DataTemplate x:Key="ClarifyMessageTemplate" x:DataType="vm:MessageViewModel">
            <controls:ClarifyQuestionCard ViewModel="{x:Bind Artifact, Converter={StaticResource ClarifyArtifactConverter}, Mode=OneWay}" />
        </DataTemplate>
        <DataTemplate x:Key="CheckpointMessageTemplate" x:DataType="vm:MessageViewModel">
            <controls:CheckpointCard ViewModel="{x:Bind Artifact, Converter={StaticResource CheckpointArtifactConverter}, Mode=OneWay}" />
        </DataTemplate>
        <DataTemplate x:Key="PermissionMessageTemplate" x:DataType="vm:MessageViewModel">
            <controls:PermissionPromptCard ViewModel="{x:Bind Artifact, Converter={StaticResource PermissionArtifactConverter}, Mode=OneWay}" />
        </DataTemplate>
        <DataTemplate x:Key="ToolCallMessageTemplate" x:DataType="vm:MessageViewModel">
            <Border Style="{StaticResource NexCode.Card.Subtle}" Margin="0,4">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource NexCode.Caption}" Foreground="{ThemeResource NexCode.Status.Info}" Text="Tool call" />
                    <TextBlock Style="{StaticResource NexCode.Code}" Text="{x:Bind Content, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ToolResultMessageTemplate" x:DataType="vm:MessageViewModel">
            <Border Style="{StaticResource NexCode.Card.Subtle}" Margin="0,4">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource NexCode.Caption}" Foreground="{ThemeResource NexCode.Status.Success}" Text="Tool result" />
                    <TextBlock Style="{StaticResource NexCode.Code}" Text="{x:Bind Content, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <infra:MessageTemplateSelector
            x:Key="MessageSelector"
            Text="{StaticResource TextMessageTemplate}"
            Plan="{StaticResource PlanMessageTemplate}"
            Todo="{StaticResource TodoMessageTemplate}"
            Clarify="{StaticResource ClarifyMessageTemplate}"
            Checkpoint="{StaticResource CheckpointMessageTemplate}"
            Permission="{StaticResource PermissionMessageTemplate}"
            ToolCall="{StaticResource ToolCallMessageTemplate}"
            ToolResult="{StaticResource ToolResultMessageTemplate}" />
    </Page.Resources>

    <Grid x:Name="ShellRoot">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <!-- Wide (>=1280): full 3-column 220 / * / 360 -->
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1280" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="NavColumn.Width" Value="220" />
                        <Setter Target="ContextColumn.Width" Value="360" />
                        <Setter Target="NavRailWide.Visibility" Value="Visible" />
                        <Setter Target="NavRailCompact.Visibility" Value="Collapsed" />
                        <Setter Target="ContextHost.Visibility" Value="Visible" />
                        <Setter Target="HamburgerButton.Visibility" Value="Collapsed" />
                        <Setter Target="ContextToggleButton.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>

                <!-- Medium (1024-1280): icon-only nav rail (60px), context 320 -->
                <VisualState x:Name="MediumState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1024" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="NavColumn.Width" Value="60" />
                        <Setter Target="ContextColumn.Width" Value="320" />
                        <Setter Target="NavRailWide.Visibility" Value="Collapsed" />
                        <Setter Target="NavRailCompact.Visibility" Value="Visible" />
                        <Setter Target="ContextHost.Visibility" Value="Visible" />
                        <Setter Target="HamburgerButton.Visibility" Value="Collapsed" />
                        <Setter Target="ContextToggleButton.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>

                <!-- Compact (768-1024): icon nav rail + center; context column hidden behind toggle -->
                <VisualState x:Name="CompactState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="768" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="NavColumn.Width" Value="60" />
                        <Setter Target="ContextColumn.Width" Value="0" />
                        <Setter Target="NavRailWide.Visibility" Value="Collapsed" />
                        <Setter Target="NavRailCompact.Visibility" Value="Visible" />
                        <Setter Target="ContextHost.Visibility" Value="Collapsed" />
                        <Setter Target="HamburgerButton.Visibility" Value="Collapsed" />
                        <Setter Target="ContextToggleButton.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>

                <!-- Tiny (<768): single column, both side panes overlay-only -->
                <VisualState x:Name="TinyState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="NavColumn.Width" Value="0" />
                        <Setter Target="ContextColumn.Width" Value="0" />
                        <Setter Target="NavRailWide.Visibility" Value="Collapsed" />
                        <Setter Target="NavRailCompact.Visibility" Value="Collapsed" />
                        <Setter Target="ContextHost.Visibility" Value="Collapsed" />
                        <Setter Target="HamburgerButton.Visibility" Value="Visible" />
                        <Setter Target="ContextToggleButton.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavColumn" Width="220" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="ContextColumn" Width="360" MinWidth="0" MaxWidth="600" />
        </Grid.ColumnDefinitions>

        <!-- Column A: nav rail (wide variant) -->
        <Border
            x:Name="NavRailWide"
            Grid.Column="0"
            Background="Transparent"
            BorderBrush="{ThemeResource NexCode.Border.Subtle}"
            BorderThickness="0,0,1,0">
            <Grid Padding="14" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource NexCode.HeaderS}" Text="Projects" />
                    <TextBlock Style="{StaticResource NexCode.Caption}" Text="Workspaces and history" />
                </StackPanel>

                <Button
                    Grid.Row="1"
                    Style="{StaticResource NexCode.Button.Primary}"
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.NewChatCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE710;" />
                        <TextBlock Text="New chat" />
                    </StackPanel>
                </Button>

                <ScrollViewer Grid.Row="2">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource NexCode.Caption}" Text="WORKSPACE" />
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Projects, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="2" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ProjectViewModel">
                                        <Border Padding="8,6" CornerRadius="{StaticResource NexCode.CornerRadius.S}">
                                            <StackPanel Spacing="2">
                                                <TextBlock Style="{StaticResource NexCode.Body}" Text="{x:Bind DisplayName, Mode=OneWay}" />
                                                <TextBlock Style="{StaticResource NexCode.Caption}" Text="{x:Bind DirectoryPath, Mode=OneWay}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource NexCode.Caption}" Text="NAVIGATION" />
                            <Button Style="{StaticResource NexCode.Button.Tertiary}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="Search" />
                            <Button Style="{StaticResource NexCode.Button.Tertiary}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{x:Bind ViewModel.OpenHistoryCommand}" Content="History" />
                            <Button Style="{StaticResource NexCode.Button.Tertiary}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{x:Bind ViewModel.OpenPlansCommand}" Content="Plans" />
                            <Button Style="{StaticResource NexCode.Button.Tertiary}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="Memories" />
                            <Button Style="{StaticResource NexCode.Button.Tertiary}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="Plugins" />
                            <Button Style="{StaticResource NexCode.Button.Tertiary}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="Automations" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Button
                    Grid.Row="3"
                    Style="{StaticResource NexCode.Button.Secondary}"
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.OpenSettingsCommand}"
                    Content="Settings" />
            </Grid>
        </Border>

        <!-- Column A (compact): icon-only nav rail -->
        <Border
            x:Name="NavRailCompact"
            Grid.Column="0"
            Visibility="Collapsed"
            Background="Transparent"
            BorderBrush="{ThemeResource NexCode.Border.Subtle}"
            BorderThickness="0,0,1,0">
            <Grid Padding="6" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button
                    Style="{StaticResource NexCode.Button.Primary}"
                    HorizontalAlignment="Stretch"
                    ToolTipService.ToolTip="New chat"
                    Command="{x:Bind ViewModel.NewChatCommand}">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                </Button>

                <StackPanel Grid.Row="1" Spacing="4" Margin="0,8,0,0">
                    <Button Style="{StaticResource NexCode.Button.Tertiary}" HorizontalAlignment="Stretch" ToolTipService.ToolTip="Search">
                        <FontIcon FontSize="14" Glyph="&#xE721;" />
                    </Button>
                    <Button Style="{StaticResource NexCode.Button.Tertiary}" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.OpenHistoryCommand}" ToolTipService.ToolTip="History">
                        <FontIcon FontSize="14" Glyph="&#xE81C;" />
                    </Button>
                    <Button Style="{StaticResource NexCode.Button.Tertiary}" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.OpenPlansCommand}" ToolTipService.ToolTip="Plans">
                        <FontIcon FontSize="14" Glyph="&#xE8A5;" />
                    </Button>
                    <Button Style="{StaticResource NexCode.Button.Tertiary}" HorizontalAlignment="Stretch" ToolTipService.ToolTip="Memories">
                        <FontIcon FontSize="14" Glyph="&#xE7B8;" />
                    </Button>
                    <Button Style="{StaticResource NexCode.Button.Tertiary}" HorizontalAlignment="Stretch" ToolTipService.ToolTip="Plugins">
                        <FontIcon FontSize="14" Glyph="&#xE950;" />
                    </Button>
                    <Button Style="{StaticResource NexCode.Button.Tertiary}" HorizontalAlignment="Stretch" ToolTipService.ToolTip="Automations">
                        <FontIcon FontSize="14" Glyph="&#xE945;" />
                    </Button>
                </StackPanel>

                <Button
                    Grid.Row="2"
                    Style="{StaticResource NexCode.Button.Secondary}"
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.OpenSettingsCommand}"
                    ToolTipService.ToolTip="Settings">
                    <FontIcon FontSize="14" Glyph="&#xE713;" />
                </Button>
            </Grid>
        </Border>

        <!-- Column B: main session area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header strip with optional toggle buttons -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="HamburgerButton"
                    Grid.Column="0"
                    Visibility="Collapsed"
                    Style="{StaticResource NexCode.Button.Tertiary}"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    Click="Hamburger_Click"
                    ToolTipService.ToolTip="Open navigation">
                    <FontIcon FontSize="14" Glyph="&#xE700;" />
                </Button>

                <controls:SessionHeaderBar
                    x:Name="HeaderBar"
                    Grid.Column="1" />

                <Button
                    x:Name="ContextToggleButton"
                    Grid.Column="2"
                    Visibility="Collapsed"
                    Style="{StaticResource NexCode.Button.Tertiary}"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Click="ContextToggle_Click"
                    ToolTipService.ToolTip="Toggle context panel">
                    <FontIcon FontSize="14" Glyph="&#xE713;" />
                </Button>
            </Grid>

            <!-- Status bar (plan/todo) -->
            <Border
                Grid.Row="1"
                Padding="14,8"
                Background="{ThemeResource NexCode.Surface.Subtle}"
                BorderBrush="{ThemeResource NexCode.Border.Subtle}"
                BorderThickness="0,0,0,1">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon FontSize="14" Glyph="&#xE762;" Foreground="{ThemeResource NexCode.Text.Secondary}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource NexCode.Caption}"
                        Text="No active plan or todo list" />
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Style="{StaticResource NexCode.Caption}"
                        Text="{x:Bind ViewModel.HelperStatusLabel, Mode=OneWay}" />
                </Grid>
            </Border>

            <!-- Virtualized transcript -->
            <Grid Grid.Row="2">
                <ScrollViewer
                    x:Name="TranscriptScrollViewer"
                    Padding="20"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsRepeater
                        x:Name="TranscriptRepeater"
                        ItemTemplate="{StaticResource MessageSelector}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="6" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </ScrollViewer>

                <!-- Empty state overlay -->
                <Grid
                    x:Name="EmptyStatePanel"
                    Visibility="Collapsed"
                    Background="Transparent"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="420"
                        Spacing="16">
                        <Border
                            Width="72"
                            Height="72"
                            HorizontalAlignment="Center"
                            CornerRadius="{StaticResource NexCode.CornerRadius.XL}"
                            Background="{ThemeResource NexCode.Accent.Subtle}">
                            <FontIcon
                                FontSize="32"
                                Glyph="&#xE8BD;"
                                Foreground="{ThemeResource NexCode.Accent.Primary}" />
                        </Border>
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource NexCode.HeaderM}"
                            Text="Welcome to NexCode" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            Style="{StaticResource NexCode.Body}"
                            Foreground="{ThemeResource NexCode.Text.Secondary}"
                            Text="Start a new session to begin chatting with your assistant. Plans, todos, and checkpoints will appear in this transcript." />
                        <Button
                            HorizontalAlignment="Center"
                            Style="{StaticResource NexCode.Button.Primary}"
                            Command="{x:Bind ViewModel.NewChatCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="12" Glyph="&#xE710;" />
                                <TextBlock Text="Start a new session" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Input area -->
            <Border
                Grid.Row="3"
                Padding="14"
                Background="{ThemeResource NexCode.Surface.Card}"
                BorderBrush="{ThemeResource NexCode.Border.Subtle}"
                BorderThickness="0,1,0,0">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="ComposerBox"
                        AcceptsReturn="True"
                        MinHeight="80"
                        PlaceholderText="Send a message to NexCode..."
                        KeyDown="ComposerBox_KeyDown" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="6">
                        <Button
                            x:Name="SendButton"
                            Style="{StaticResource NexCode.Button.Primary}"
                            Click="Send_Click"
                            Content="Send" />
                        <Button
                            x:Name="StopButton"
                            Style="{StaticResource NexCode.Button.Secondary}"
                            Click="Stop_Click"
                            IsEnabled="False"
                            Content="Stop" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Column C: context tabs -->
        <Border
            x:Name="ContextHost"
            Grid.Column="2"
            Background="Transparent"
            BorderBrush="{ThemeResource NexCode.Border.Subtle}"
            BorderThickness="1,0,0,0">
            <TabView IsAddTabButtonVisible="False">
                <TabViewItem Header="Run" IsClosable="False">
                    <StackPanel Padding="14" Spacing="8">
                        <TextBlock Style="{StaticResource NexCode.HeaderS}" Text="Run activity" />
                        <ListView x:Name="RunActivityList" Height="420" SelectionMode="None" />
                    </StackPanel>
                </TabViewItem>
                <TabViewItem Header="Git" IsClosable="False">
                    <StackPanel Padding="14" Spacing="8">
                        <TextBlock Style="{StaticResource NexCode.HeaderS}" Text="Git manager" />
                        <TextBlock Style="{StaticResource NexCode.Caption}" Text="Git status, branches, and checkpoints will mount here in slice 0015." />
                    </StackPanel>
                </TabViewItem>
                <TabViewItem Header="Code Diff" IsClosable="False">
                    <StackPanel Padding="14" Spacing="8">
                        <TextBlock Style="{StaticResource NexCode.HeaderS}" Text="Code diff" />
                        <TextBlock Style="{StaticResource NexCode.Caption}" Text="Diff viewer placeholder." />
                    </StackPanel>
                </TabViewItem>
                <TabViewItem Header="Editor" IsClosable="False">
                    <StackPanel Padding="14" Spacing="8">
                        <TextBlock Style="{StaticResource NexCode.HeaderS}" Text="Built-in editor" />
                        <TextBlock Style="{StaticResource NexCode.Caption}" Text="Monaco surface mounts in slice 0014." />
                    </StackPanel>
                </TabViewItem>
                <TabViewItem Header="Plans" IsClosable="False">
                    <StackPanel Padding="14" Spacing="8">
                        <TextBlock Style="{StaticResource NexCode.HeaderS}" Text="Plans workspace" />
                        <TextBlock Style="{StaticResource NexCode.Caption}" Text="Plan-first workflow placeholder." />
                    </StackPanel>
                </TabViewItem>
            </TabView>
        </Border>

        <!-- Overlay flyout for the context panel (compact / tiny) -->
        <Grid
            x:Name="ContextOverlayHost"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Visibility="Collapsed"
            Background="#80010409">
            <Border
                Width="360"
                HorizontalAlignment="Right"
                Background="{ThemeResource NexCode.Surface.Card}"
                BorderBrush="{ThemeResource NexCode.Border.Strong}"
                BorderThickness="1,0,0,0"
                Translation="0,0,32">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <Grid RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="14,10" Background="{ThemeResource NexCode.Surface.Card}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource NexCode.HeaderS}" Text="Context" VerticalAlignment="Center" />
                        <Button
                            Grid.Column="1"
                            Style="{StaticResource NexCode.Button.Tertiary}"
                            Click="ContextToggle_Click"
                            ToolTipService.ToolTip="Close">
                            <FontIcon FontSize="12" Glyph="&#xE711;" />
                        </Button>
                    </Grid>
                    <TabView Grid.Row="1" IsAddTabButtonVisible="False">
                        <TabViewItem Header="Run" IsClosable="False">
                            <StackPanel Padding="14" Spacing="8">
                                <TextBlock Style="{StaticResource NexCode.HeaderS}" Text="Run activity" />
                                <TextBlock Style="{StaticResource NexCode.Caption}" Text="Run timeline appears in this overlay on smaller windows." />
                            </StackPanel>
                        </TabViewItem>
                        <TabViewItem Header="Git" IsClosable="False">
                            <StackPanel Padding="14" Spacing="8">
                                <TextBlock Style="{StaticResource NexCode.HeaderS}" Text="Git manager" />
                                <TextBlock Style="{StaticResource NexCode.Caption}" Text="Git status, branches, and checkpoints." />
                            </StackPanel>
                        </TabViewItem>
                        <TabViewItem Header="Editor" IsClosable="False">
                            <StackPanel Padding="14" Spacing="8">
                                <TextBlock Style="{StaticResource NexCode.HeaderS}" Text="Editor" />
                                <TextBlock Style="{StaticResource NexCode.Caption}" Text="Monaco editor placeholder." />
                            </StackPanel>
                        </TabViewItem>
                    </TabView>
                </Grid>
            </Border>
        </Grid>

        <!-- Overlay flyout for nav (tiny only) -->
        <Grid
            x:Name="NavOverlayHost"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Visibility="Collapsed"
            Background="#80010409">
            <Border
                Width="240"
                HorizontalAlignment="Left"
                Background="{ThemeResource NexCode.Surface.Card}"
                BorderBrush="{ThemeResource NexCode.Border.Strong}"
                BorderThickness="0,0,1,0"
                Translation="0,0,32">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <StackPanel Padding="12" Spacing="6">
                    <TextBlock Style="{StaticResource NexCode.HeaderS}" Text="Navigation" />
                    <Button Style="{StaticResource NexCode.Button.Primary}" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.NewChatCommand}" Content="New chat" />
                    <Button Style="{StaticResource NexCode.Button.Tertiary}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{x:Bind ViewModel.OpenHistoryCommand}" Content="History" />
                    <Button Style="{StaticResource NexCode.Button.Tertiary}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{x:Bind ViewModel.OpenPlansCommand}" Content="Plans" />
                    <Button Style="{StaticResource NexCode.Button.Secondary}" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.OpenSettingsCommand}" Content="Settings" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
