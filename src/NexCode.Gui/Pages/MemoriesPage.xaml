<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NexCode.Gui.Pages.MemoriesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NexCode.Gui.ViewModels.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Foreground="{StaticResource NexCode.Text.Primary}"
                Text="Memories" />
            <TextBlock
                Foreground="{StaticResource NexCode.Text.Secondary}"
                Text="Long-lived facts NexCode injects into prompts. Tag and scope per memory; copy a nexcode:// URI to reference one." />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox
                PlaceholderText="Search memories..."
                QueryIcon="Find"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox
                Grid.Column="1"
                ItemsSource="{x:Bind ViewModel.ScopeOptions}"
                PlaceholderText="Scope"
                SelectedItem="{x:Bind ViewModel.ScopeFilter, Mode=TwoWay}" />
            <Button Grid.Column="2" Command="{x:Bind ViewModel.AddMemoryCommand}" Content="Add" />
            <Button Grid.Column="3" Command="{x:Bind ViewModel.ImportCommand}" Content="Import" />
            <Button Grid.Column="4" Command="{x:Bind ViewModel.ExportCommand}" Content="Export" />
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Border
                Padding="0"
                Background="{StaticResource NexCode.Surface.Card}"
                BorderBrush="{StaticResource NexCode.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="12">
                <ListView
                    x:Name="MemoriesListView"
                    ItemsSource="{x:Bind ViewModel.Memories, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedMemory, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:MemoryRowViewModel">
                            <StackPanel Padding="12,8" Spacing="2">
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Key, Mode=OneWay}" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{StaticResource NexCode.Text.Secondary}"
                                        Text="{x:Bind Scope, Mode=OneWay}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{StaticResource NexCode.Text.Tertiary}"
                                        Text="{x:Bind TagsCsv, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Border
                Grid.Column="1"
                Padding="16"
                Background="{StaticResource NexCode.Surface.Card}"
                BorderBrush="{StaticResource NexCode.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        DataContext="{x:Bind ViewModel.SelectedMemory, Mode=OneWay}"
                        Spacing="12">
                        <TextBlock FontWeight="SemiBold" Text="Memory details" />
                        <TextBox Header="Key" Text="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox
                            Header="Scope"
                            ItemsSource="{x:Bind ViewModel.ScopeOptions}"
                            SelectedItem="{Binding Scope, Mode=TwoWay}" />
                        <TextBox
                            AcceptsReturn="True"
                            Header="Value"
                            MinHeight="160"
                            Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />
                        <TextBox Header="Tags (CSV)" Text="{Binding TagsCsv, Mode=OneWay}" IsReadOnly="True" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Command="{Binding ElementName=MemoriesListView, Path=DataContext.CopyUriCommand}"
                                CommandParameter="{Binding}"
                                Content="Copy URI" />
                            <Button
                                Background="{StaticResource NexCode.Status.Error}"
                                Command="{Binding ElementName=MemoriesListView, Path=DataContext.DeleteCommand}"
                                CommandParameter="{Binding}"
                                Content="Delete"
                                Foreground="{StaticResource NexCode.Text.Primary}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock
            Grid.Row="3"
            Foreground="{StaticResource NexCode.Text.Secondary}"
            Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
    </Grid>
</Page>
