<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NexCode.Gui.Pages.Settings.AppearanceSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" Spacing="20">
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Foreground="{StaticResource NexCode.Text.Primary}"
                Text="Appearance" />

            <Border
                Padding="16"
                Background="{StaticResource NexCode.Surface.Card}"
                BorderBrush="{StaticResource NexCode.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel Spacing="12">
                    <TextBlock FontWeight="SemiBold" Text="Theme" />
                    <ComboBox
                        Header="Theme"
                        ItemsSource="{x:Bind ViewModel.Themes}"
                        SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}" />
                    <ComboBox
                        Header="Message density"
                        ItemsSource="{x:Bind ViewModel.Densities}"
                        SelectedItem="{x:Bind ViewModel.SelectedDensity, Mode=TwoWay}" />
                    <Slider
                        Header="Font scale"
                        Maximum="1.5"
                        Minimum="0.85"
                        StepFrequency="0.05"
                        Value="{x:Bind ViewModel.FontScale, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <Border
                Padding="16"
                Background="{StaticResource NexCode.Surface.Card}"
                BorderBrush="{StaticResource NexCode.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel Spacing="10">
                    <TextBlock FontWeight="SemiBold" Text="Accent color" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.AccentSwatches}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Button
                                    Width="40"
                                    Height="40"
                                    Click="AccentSwatch_Click"
                                    CornerRadius="20"
                                    Tag="{x:Bind}">
                                    <Border
                                        Width="28"
                                        Height="28"
                                        Background="{x:Bind}"
                                        CornerRadius="14" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        FontSize="12"
                        Foreground="{StaticResource NexCode.Text.Secondary}"
                        Text="{x:Bind ViewModel.SelectedAccent, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind ViewModel.ApplyCommand}" Content="Apply" />
                <Button Command="{x:Bind ViewModel.ResetCommand}" Content="Reset" />
            </StackPanel>

            <TextBlock
                Foreground="{StaticResource NexCode.Text.Secondary}"
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>
