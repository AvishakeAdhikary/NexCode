<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="NexCode.Gui.Pages.Settings.JsonEditorSheet"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        Padding="16"
        Background="{StaticResource NexCode.Surface.Card}"
        BorderBrush="{StaticResource NexCode.Border.Subtle}"
        BorderThickness="1"
        CornerRadius="12">
        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource NexCode.Text.Primary}"
                        Text="{x:Bind Title, Mode=OneWay}" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{StaticResource NexCode.Text.Secondary}"
                        Text="JSON editor — Slice 0015 will swap this textbox for Monaco." />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Click="CloseButton_Click"
                    Content="Close" />
            </Grid>

            <TextBox
                x:Name="EditorTextBox"
                Grid.Row="1"
                AcceptsReturn="True"
                FontFamily="Consolas"
                FontSize="13"
                IsSpellCheckEnabled="False"
                MinHeight="280"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                Text="{x:Bind Document, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="NoWrap" />

            <TextBlock
                x:Name="StatusTextBlock"
                Grid.Row="2"
                Foreground="{StaticResource NexCode.Text.Secondary}"
                Text="{x:Bind Status, Mode=OneWay}" />

            <StackPanel
                Grid.Row="3"
                Orientation="Horizontal"
                Spacing="8">
                <Button Click="FormatButton_Click" Content="Format" />
                <Button Click="ReloadButton_Click" Content="Reload" />
                <Button Click="RevertButton_Click" Content="Revert" />
                <Button
                    Background="{StaticResource NexCode.Accent.Primary}"
                    Click="SaveButton_Click"
                    Content="Save"
                    Foreground="{StaticResource NexCode.Text.Primary}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
