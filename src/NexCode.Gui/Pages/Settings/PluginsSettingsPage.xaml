<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NexCode.Gui.Pages.Settings.PluginsSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NexCode.Gui.ViewModels.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Foreground="{StaticResource NexCode.Text.Primary}"
                Text="Plugins" />
            <TextBlock
                Foreground="{StaticResource NexCode.Text.Secondary}"
                Text="Installed plugins. Enable, disable, update, or uninstall." />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Padding="12"
                Background="{StaticResource NexCode.Surface.Card}"
                BorderBrush="{StaticResource NexCode.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock FontWeight="SemiBold" Text="Installed" />

                    <ListView
                        x:Name="PluginsListView"
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.Plugins, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedPlugin, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:PluginRowViewModel">
                                <StackPanel Padding="6,4" Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Name, Mode=OneWay}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{StaticResource NexCode.Text.Secondary}"
                                        Text="{x:Bind Version, Mode=OneWay}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Button
                        Grid.Row="2"
                        Command="{x:Bind ViewModel.InstallFromFileCommand}"
                        Content="Install from .nexplug"
                        HorizontalAlignment="Stretch" />
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Padding="16"
                Background="{StaticResource NexCode.Surface.Card}"
                BorderBrush="{StaticResource NexCode.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        DataContext="{x:Bind ViewModel.SelectedPlugin, Mode=OneWay}"
                        Spacing="12">
                        <TextBlock FontWeight="SemiBold" Text="Plugin details" />
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Version}" Foreground="{StaticResource NexCode.Text.Secondary}" />
                        <TextBlock Text="{Binding Author}" Foreground="{StaticResource NexCode.Text.Secondary}" />
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                        <Border
                            Padding="10"
                            Background="{StaticResource NexCode.Surface.Subtle}"
                            CornerRadius="8">
                            <StackPanel Spacing="4">
                                <TextBlock FontWeight="SemiBold" Text="Permissions" />
                                <TextBlock Text="{Binding Permissions}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <ToggleSwitch Header="Enabled" IsOn="{Binding IsEnabled, Mode=TwoWay}" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Command="{Binding ElementName=PluginsListView, Path=DataContext.ToggleCommand}"
                                CommandParameter="{Binding}"
                                Content="Toggle" />
                            <Button
                                Command="{Binding ElementName=PluginsListView, Path=DataContext.CheckUpdateCommand}"
                                CommandParameter="{Binding}"
                                Content="Check update" />
                            <Button
                                Background="{StaticResource NexCode.Status.Error}"
                                Command="{Binding ElementName=PluginsListView, Path=DataContext.UninstallCommand}"
                                CommandParameter="{Binding}"
                                Content="Uninstall"
                                Foreground="{StaticResource NexCode.Text.Primary}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock
            Grid.Row="2"
            Foreground="{StaticResource NexCode.Text.Secondary}"
            Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
    </Grid>
</Page>
