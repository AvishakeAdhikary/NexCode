<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NexCode.Gui.Pages.Settings.KeyboardSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NexCode.Gui.ViewModels.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Foreground="{StaticResource NexCode.Text.Primary}"
                Text="Keyboard shortcuts" />
            <TextBlock
                Foreground="{StaticResource NexCode.Text.Secondary}"
                Text="Default bindings come from spec §20.2. Edit, add a secondary, or reset per row." />
        </StackPanel>

        <AutoSuggestBox
            Grid.Row="1"
            PlaceholderText="Filter bindings..."
            QueryIcon="Find"
            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <Border
            Grid.Row="2"
            Padding="0"
            Background="{StaticResource NexCode.Surface.Card}"
            BorderBrush="{StaticResource NexCode.Border.Subtle}"
            BorderThickness="1"
            CornerRadius="12">
            <ListView
                x:Name="BindingsListView"
                ItemsSource="{x:Bind ViewModel.Bindings, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedBinding, Mode=TwoWay}"
                SelectionMode="Single">
                <ListView.HeaderTemplate>
                    <DataTemplate>
                        <Grid Padding="12,10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontWeight="SemiBold" Text="Action" />
                            <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Category" />
                            <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Primary" />
                            <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="Secondary" />
                            <TextBlock Grid.Column="4" FontWeight="SemiBold" Text="Actions" />
                        </Grid>
                    </DataTemplate>
                </ListView.HeaderTemplate>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:KeybindingRowViewModel">
                        <Grid Padding="12,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind Action, Mode=OneWay}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource NexCode.Text.Secondary}"
                                Text="{x:Bind Category, Mode=OneWay}" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontFamily="Consolas"
                                Text="{x:Bind Primary, Mode=OneWay}" />
                            <TextBlock
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                FontFamily="Consolas"
                                Foreground="{StaticResource NexCode.Text.Secondary}"
                                Text="{x:Bind Secondary, Mode=OneWay}" />
                            <StackPanel
                                Grid.Column="4"
                                Orientation="Horizontal"
                                Spacing="4">
                                <Button
                                    Click="EditButton_Click"
                                    Content="Edit"
                                    Tag="{x:Bind}" />
                                <Button
                                    Click="AddSecondaryButton_Click"
                                    Content="+ Secondary"
                                    Tag="{x:Bind}" />
                                <Button
                                    Click="ResetButton_Click"
                                    Content="Reset"
                                    Tag="{x:Bind}" />
                                <Button
                                    Click="RemoveButton_Click"
                                    Content="Remove"
                                    Tag="{x:Bind}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <TextBlock
            Grid.Row="3"
            Foreground="{StaticResource NexCode.Text.Secondary}"
            Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
    </Grid>
</Page>
