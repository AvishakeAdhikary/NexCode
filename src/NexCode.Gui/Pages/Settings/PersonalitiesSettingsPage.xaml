<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NexCode.Gui.Pages.Settings.PersonalitiesSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NexCode.Gui.ViewModels.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Foreground="{StaticResource NexCode.Text.Primary}"
                Text="Personalities" />
            <TextBlock
                Foreground="{StaticResource NexCode.Text.Secondary}"
                Text="Layered tone and verbosity prompts. Scope to global or to a specific project." />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Padding="12"
                Background="{StaticResource NexCode.Surface.Card}"
                BorderBrush="{StaticResource NexCode.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock FontWeight="SemiBold" Text="Personalities" />

                    <ListView
                        x:Name="PersonalitiesListView"
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.Personalities, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedPersonality, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:PersonalityRowViewModel">
                                <StackPanel Padding="6,4" Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Name, Mode=OneWay}" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{StaticResource NexCode.Text.Secondary}"
                                            Text="{x:Bind Tone, Mode=OneWay}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{StaticResource NexCode.Status.Success}"
                                            Text="default"
                                            Visibility="{x:Bind IsDefault, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel
                        Grid.Row="2"
                        Orientation="Horizontal"
                        Spacing="6">
                        <Button Command="{x:Bind ViewModel.AddPersonalityCommand}" Content="Add" />
                        <Button
                            Command="{x:Bind ViewModel.DuplicatePersonalityCommand}"
                            CommandParameter="{x:Bind ViewModel.SelectedPersonality, Mode=OneWay}"
                            Content="Duplicate" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Padding="16"
                Background="{StaticResource NexCode.Surface.Card}"
                BorderBrush="{StaticResource NexCode.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        DataContext="{x:Bind ViewModel.SelectedPersonality, Mode=OneWay}"
                        Spacing="12">
                        <TextBlock FontWeight="SemiBold" Text="Personality details" />
                        <TextBox Header="Name" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Header="Description" Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox
                            Header="Tone"
                            ItemsSource="{x:Bind ViewModel.ToneOptions}"
                            SelectedItem="{Binding Tone, Mode=TwoWay}" />
                        <ComboBox
                            Header="Verbosity"
                            ItemsSource="{x:Bind ViewModel.VerbosityOptions}"
                            SelectedItem="{Binding Verbosity, Mode=TwoWay}" />
                        <ComboBox
                            Header="Scope"
                            ItemsSource="{x:Bind ViewModel.ScopeOptions}"
                            SelectedItem="{Binding Scope, Mode=TwoWay}" />
                        <TextBox
                            AcceptsReturn="True"
                            FontFamily="Consolas"
                            Header="System prompt fragment"
                            MinHeight="120"
                            Text="{Binding SystemPromptFragment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Command="{Binding ElementName=PersonalitiesListView, Path=DataContext.SetDefaultCommand}"
                                CommandParameter="{Binding}"
                                Content="Set as default" />
                            <Button
                                Background="{StaticResource NexCode.Status.Error}"
                                Command="{Binding ElementName=PersonalitiesListView, Path=DataContext.DeletePersonalityCommand}"
                                CommandParameter="{Binding}"
                                Content="Delete"
                                Foreground="{StaticResource NexCode.Text.Primary}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock
            Grid.Row="2"
            Foreground="{StaticResource NexCode.Text.Secondary}"
            Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
    </Grid>
</Page>
