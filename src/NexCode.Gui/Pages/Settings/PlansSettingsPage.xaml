<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NexCode.Gui.Pages.Settings.PlansSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" Spacing="20">
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Foreground="{StaticResource NexCode.Text.Primary}"
                Text="Plans &amp; todos" />

            <Border
                Padding="16"
                Background="{StaticResource NexCode.Surface.Card}"
                BorderBrush="{StaticResource NexCode.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel Spacing="12">
                    <TextBlock FontWeight="SemiBold" Text="Defaults" />
                    <ToggleSwitch Header="Auto-present plan when ready" IsOn="True" />
                    <ToggleSwitch Header="Auto-start todo list when plan is confirmed" IsOn="True" />
                    <ToggleSwitch Header="Require explicit confirmation for destructive steps" IsOn="True" />
                </StackPanel>
            </Border>

            <Border
                Padding="16"
                Background="{StaticResource NexCode.Surface.Card}"
                BorderBrush="{StaticResource NexCode.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel Spacing="12">
                    <TextBlock FontWeight="SemiBold" Text="Retention" />
                    <ComboBox Header="Plan retention policy" SelectedIndex="0">
                        <ComboBoxItem Content="Keep all" />
                        <ComboBoxItem Content="Keep last 50 per session" />
                        <ComboBoxItem Content="Keep 90 days" />
                        <ComboBoxItem Content="Keep 30 days" />
                    </ComboBox>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
