<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NexCode.Gui.Pages.Settings.ModesSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NexCode.Gui.ViewModels.Pages"
    xmlns:settings="using:NexCode.Gui.Pages.Settings"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Foreground="{StaticResource NexCode.Text.Primary}"
                Text="Modes" />
            <TextBlock
                Foreground="{StaticResource NexCode.Text.Secondary}"
                Text="Built-in modes are locked. Custom modes support add / duplicate / delete / import / export and a JSON editor sheet." />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Padding="12"
                Background="{StaticResource NexCode.Surface.Card}"
                BorderBrush="{StaticResource NexCode.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock FontWeight="SemiBold" Text="Modes" />

                    <ListView
                        x:Name="ModesListView"
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.Modes, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedMode, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ModeRowViewModel">
                                <StackPanel Padding="6,4" Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Name, Mode=OneWay}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{StaticResource NexCode.Text.Secondary}"
                                        Text="built-in"
                                        Visibility="{x:Bind IsBuiltIn, Mode=OneWay}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel
                        Grid.Row="2"
                        Orientation="Horizontal"
                        Spacing="6">
                        <Button Command="{x:Bind ViewModel.AddModeCommand}" Content="Add" />
                        <Button
                            Command="{x:Bind ViewModel.DuplicateModeCommand}"
                            CommandParameter="{x:Bind ViewModel.SelectedMode, Mode=OneWay}"
                            Content="Duplicate" />
                        <Button Command="{x:Bind ViewModel.ImportModeCommand}" Content="Import" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Padding="16"
                Background="{StaticResource NexCode.Surface.Card}"
                BorderBrush="{StaticResource NexCode.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        DataContext="{x:Bind ViewModel.SelectedMode, Mode=OneWay}"
                        Spacing="12">
                        <TextBlock FontWeight="SemiBold" Text="Mode details" />
                        <TextBox
                            Header="Name"
                            IsReadOnly="{Binding IsBuiltIn}"
                            Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox
                            Header="Icon (glyph or path)"
                            IsReadOnly="{Binding IsBuiltIn}"
                            Text="{Binding Icon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox
                            Header="Accent color (#rrggbb)"
                            IsReadOnly="{Binding IsBuiltIn}"
                            Text="{Binding AccentColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox
                            AcceptsReturn="True"
                            FontFamily="Consolas"
                            Header="System prompt"
                            IsReadOnly="{Binding IsBuiltIn}"
                            MinHeight="160"
                            Text="{Binding SystemPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="OpenJsonEditor_Click" Content="Open JSON editor" />
                            <Button
                                Command="{Binding ElementName=ModesListView, Path=DataContext.ExportModeCommand}"
                                CommandParameter="{Binding}"
                                Content="Export" />
                            <Button
                                Background="{StaticResource NexCode.Status.Error}"
                                Command="{Binding ElementName=ModesListView, Path=DataContext.DeleteModeCommand}"
                                CommandParameter="{Binding}"
                                Content="Delete"
                                Foreground="{StaticResource NexCode.Text.Primary}"
                                IsEnabled="{Binding ElementName=ModesListView, Path=DataContext.CanDeleteSelected}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock
            Grid.Row="2"
            Foreground="{StaticResource NexCode.Text.Secondary}"
            Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
    </Grid>
</Page>
