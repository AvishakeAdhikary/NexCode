<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NexCode.Gui.Pages.Settings.AboutSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" Spacing="20">
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Foreground="{StaticResource NexCode.Text.Primary}"
                Text="About" />

            <Border
                Padding="16"
                Background="{StaticResource NexCode.Surface.Card}"
                BorderBrush="{StaticResource NexCode.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel Spacing="6">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="NexCode" />
                    <TextBlock Foreground="{StaticResource NexCode.Text.Secondary}" Text="Spec-anchored agentic IDE for Windows." />
                    <TextBlock x:Name="VersionTextBlock" Foreground="{StaticResource NexCode.Text.Secondary}" Text="Version: dev" />
                    <TextBlock x:Name="ChannelTextBlock" Foreground="{StaticResource NexCode.Text.Secondary}" Text="Channel: stable" />
                </StackPanel>
            </Border>

            <Border
                Padding="16"
                Background="{StaticResource NexCode.Surface.Card}"
                BorderBrush="{StaticResource NexCode.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="Legal &amp; resources" />
                    <HyperlinkButton Click="OpenPrivacy_Click" Content="Privacy Policy" />
                    <HyperlinkButton Click="OpenTos_Click" Content="Terms of Service" />
                    <HyperlinkButton Click="OpenEula_Click" Content="End User License Agreement" />
                    <HyperlinkButton Click="OpenLicenses_Click" Content="Open-source licenses" />
                    <HyperlinkButton Click="OpenChangelog_Click" Content="Changelog" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
