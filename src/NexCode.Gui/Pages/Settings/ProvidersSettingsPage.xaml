<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NexCode.Gui.Pages.Settings.ProvidersSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NexCode.Gui.ViewModels.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Foreground="{StaticResource NexCode.Text.Primary}"
                Text="LLM Providers" />
            <TextBlock
                Foreground="{StaticResource NexCode.Text.Secondary}"
                Text="API keys never touch the renderer; they are sent to the helper which persists them encrypted." />
        </StackPanel>

        <Grid
            Grid.Row="1"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Padding="12"
                Background="{StaticResource NexCode.Surface.Card}"
                BorderBrush="{StaticResource NexCode.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock FontWeight="SemiBold" Text="Configured providers" />

                    <ListView
                        x:Name="ProvidersListView"
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.Providers, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedProvider, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProviderRowViewModel">
                                <StackPanel Padding="6,4" Spacing="2">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource NexCode.Text.Primary}"
                                        Text="{x:Bind DisplayName, Mode=OneWay}" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{StaticResource NexCode.Text.Secondary}"
                                            Text="{x:Bind ProviderKey, Mode=OneWay}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{StaticResource NexCode.Status.Success}"
                                            Text="default"
                                            Visibility="{x:Bind IsDefault, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Button
                        Grid.Row="2"
                        Command="{x:Bind ViewModel.AddProviderCommand}"
                        Content="Add provider"
                        HorizontalAlignment="Stretch" />
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Padding="16"
                Background="{StaticResource NexCode.Surface.Card}"
                BorderBrush="{StaticResource NexCode.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        DataContext="{x:Bind ViewModel.SelectedProvider, Mode=OneWay}"
                        Spacing="12">
                        <TextBlock FontWeight="SemiBold" Text="Provider details" />
                        <ComboBox
                            Header="Provider type"
                            ItemsSource="{x:Bind vm:ProvidersSettingsViewModel.KnownProviderKeys}"
                            SelectedItem="{Binding ProviderKey, Mode=TwoWay}" />
                        <TextBox Header="Display name" Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Header="Base URL" Text="{Binding BaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Header="Default model id" Text="{Binding DefaultModelId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <PasswordBox Header="API key" Password="{Binding ApiKeyEntry, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ToggleSwitch Header="Default for new sessions" IsOn="{Binding IsDefault, Mode=TwoWay}" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Command="{Binding ElementName=ProvidersListView, Path=DataContext.SaveProviderCommand}"
                                CommandParameter="{Binding}"
                                Content="Save"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button
                                Command="{Binding ElementName=ProvidersListView, Path=DataContext.SetDefaultCommand}"
                                CommandParameter="{Binding}"
                                Content="Set as default" />
                            <Button
                                Command="{Binding ElementName=ProvidersListView, Path=DataContext.TestConnectionCommand}"
                                CommandParameter="{Binding}"
                                Content="Test connection" />
                            <Button
                                Background="{StaticResource NexCode.Status.Error}"
                                Command="{Binding ElementName=ProvidersListView, Path=DataContext.RemoveProviderCommand}"
                                CommandParameter="{Binding}"
                                Content="Remove"
                                Foreground="{StaticResource NexCode.Text.Primary}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock
            Grid.Row="2"
            Foreground="{StaticResource NexCode.Text.Secondary}"
            Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
    </Grid>
</Page>
