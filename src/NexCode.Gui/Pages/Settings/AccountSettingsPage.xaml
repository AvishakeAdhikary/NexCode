<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NexCode.Gui.Pages.Settings.AccountSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" Spacing="20">
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Foreground="{StaticResource NexCode.Text.Primary}"
                Text="Account" />

            <Border
                Padding="16"
                Background="{StaticResource NexCode.Surface.Card}"
                BorderBrush="{StaticResource NexCode.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel Spacing="10">
                    <TextBlock FontWeight="SemiBold" Text="Identity" />
                    <TextBlock x:Name="EmailTextBlock" Foreground="{StaticResource NexCode.Text.Secondary}" Text="Email: not signed in" />
                    <TextBlock x:Name="TenantTextBlock" Foreground="{StaticResource NexCode.Text.Secondary}" Text="Tenant: -" />
                    <TextBlock x:Name="TierTextBlock" Foreground="{StaticResource NexCode.Text.Secondary}" Text="Subscription tier: Free" />
                </StackPanel>
            </Border>

            <Border
                Padding="16"
                Background="{StaticResource NexCode.Surface.Card}"
                BorderBrush="{StaticResource NexCode.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel Spacing="10">
                    <TextBlock FontWeight="SemiBold" Text="Subscription" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Restore purchases" />
                        <Button Content="Manage subscription" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Padding="16"
                Background="{StaticResource NexCode.Surface.Card}"
                BorderBrush="{StaticResource NexCode.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel Spacing="10">
                    <TextBlock FontWeight="SemiBold" Text="Sign-in" />
                    <Button Content="Sign out" />
                </StackPanel>
            </Border>

            <Border
                x:Name="SuperUserPanel"
                Padding="16"
                Background="{StaticResource NexCode.Surface.Card}"
                BorderBrush="{StaticResource NexCode.Status.Warning}"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <TextBlock FontWeight="SemiBold" Text="Super-user developer panel" />
                    <TextBlock
                        Foreground="{StaticResource NexCode.Text.Secondary}"
                        Text="Visible only when the helper reports a super-user / dev claim."
                        TextWrapping="Wrap" />
                    <Button Content="Force entitlement refresh" />
                    <Button Content="Toggle dev provider stubs" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
