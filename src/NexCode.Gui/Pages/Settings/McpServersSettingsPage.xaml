<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NexCode.Gui.Pages.Settings.McpServersSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NexCode.Gui.ViewModels.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Foreground="{StaticResource NexCode.Text.Primary}"
                Text="MCP servers" />
            <TextBlock
                Foreground="{StaticResource NexCode.Text.Secondary}"
                Text="Model Context Protocol servers exposing tools to NexCode. Edit JSON manifests with the embedded sheet." />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Padding="12"
                Background="{StaticResource NexCode.Surface.Card}"
                BorderBrush="{StaticResource NexCode.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock FontWeight="SemiBold" Text="Servers" />

                    <ListView
                        x:Name="McpListView"
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.Servers, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedServer, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:McpServerRowViewModel">
                                <StackPanel Padding="6,4" Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Name, Mode=OneWay}" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{StaticResource NexCode.Text.Secondary}"
                                            Text="{x:Bind Transport, Mode=OneWay}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{StaticResource NexCode.Status.Info}"
                                            Text="{x:Bind Status, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Button
                        Grid.Row="2"
                        Command="{x:Bind ViewModel.AddServerCommand}"
                        Content="Add MCP server"
                        HorizontalAlignment="Stretch" />
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Padding="16"
                Background="{StaticResource NexCode.Surface.Card}"
                BorderBrush="{StaticResource NexCode.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        DataContext="{x:Bind ViewModel.SelectedServer, Mode=OneWay}"
                        Spacing="12">
                        <TextBlock FontWeight="SemiBold" Text="Server details" />
                        <TextBox Header="Name" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox Header="Transport" SelectedItem="{Binding Transport, Mode=TwoWay}">
                            <ComboBoxItem Content="stdio" />
                            <ComboBoxItem Content="http" />
                            <ComboBoxItem Content="websocket" />
                        </ComboBox>
                        <TextBox Header="Command" Text="{Binding Command, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ToggleSwitch
                            Header="Enabled"
                            IsOn="{Binding IsEnabled, Mode=TwoWay}"
                            Toggled="EnabledToggle_Toggled" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="OpenManifest_Click" Content="Edit manifest JSON" />
                            <Button
                                Command="{Binding ElementName=McpListView, Path=DataContext.TestServerCommand}"
                                CommandParameter="{Binding}"
                                Content="Test connection" />
                            <Button
                                Background="{StaticResource NexCode.Status.Error}"
                                Command="{Binding ElementName=McpListView, Path=DataContext.DeleteServerCommand}"
                                CommandParameter="{Binding}"
                                Content="Delete"
                                Foreground="{StaticResource NexCode.Text.Primary}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock
            Grid.Row="2"
            Foreground="{StaticResource NexCode.Text.Secondary}"
            Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
    </Grid>
</Page>
