<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NexCode.Gui.Pages.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Foreground="{StaticResource NexCode.Text.Primary}"
                Text="Search" />
            <TextBlock
                Foreground="{StaticResource NexCode.Text.Secondary}"
                Text="Full-text search across projects, sessions, plans, and memories." />
        </StackPanel>

        <AutoSuggestBox
            x:Name="QueryBox"
            Grid.Row="1"
            PlaceholderText="Search everything..."
            QueryIcon="Find"
            QuerySubmitted="QueryBox_QuerySubmitted" />

        <Border
            Grid.Row="2"
            Padding="0"
            Background="{StaticResource NexCode.Surface.Card}"
            BorderBrush="{StaticResource NexCode.Border.Subtle}"
            BorderThickness="1"
            CornerRadius="12">
            <ListView x:Name="ResultsListView" SelectionMode="Single">
                <ListViewItem Content="No results yet — type a query and press Enter." IsHitTestVisible="False" />
            </ListView>
        </Border>

        <TextBlock
            x:Name="StatusTextBlock"
            Grid.Row="3"
            Foreground="{StaticResource NexCode.Text.Secondary}" />
    </Grid>
</Page>
