<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NexCode.Gui.Pages.GitPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:NexCode.Gui.ViewModels.Pages"
    mc:Ignorable="d">
    <Page.Resources>
        <vm:GitPageViewModel x:Key="ViewModel" />
    </Page.Resources>
    <Grid DataContext="{StaticResource ViewModel}" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="12" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="Git Manager" />
                <TextBlock Text="{Binding CurrentBranch}" Opacity="0.72" />
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" />
            <Button Grid.Column="2" Content="Fetch" Command="{Binding FetchCommand}" />
            <Button Grid.Column="3" Content="Pull" Command="{Binding PullCommand}" />
            <Button Grid.Column="4" Content="Push" Command="{Binding PushCommand}" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontWeight="SemiBold" Text="Working tree" />
                    <ListView Grid.Row="1" ItemsSource="{Binding WorkingTree}" SelectionMode="Multiple">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsStaged, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="1" Text="{Binding IndexState}" Opacity="0.7" />
                                    <TextBlock Grid.Column="2" Text="{Binding Path}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="2" Spacing="6">
                        <TextBox PlaceholderText="Commit message" Text="{Binding CommitMessage, Mode=TwoWay}" AcceptsReturn="True" MinHeight="64" />
                        <Button Content="Commit" Command="{Binding CommitCommand}" Style="{ThemeResource AccentButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12">
                <TabView>
                    <TabViewItem Header="Branches" IsClosable="False">
                        <StackPanel Padding="6" Spacing="6">
                            <ListView ItemsSource="{Binding Branches}" Height="180">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Upstream}" Opacity="0.6" />
                                            <TextBlock Grid.Column="2" Text="{Binding Ahead}" Opacity="0.7" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Create" Command="{Binding CreateBranchCommand}" />
                                <Button Content="Switch" Command="{Binding SwitchBranchCommand}" />
                                <Button Content="Merge" Command="{Binding MergeBranchCommand}" />
                                <Button Content="Delete" Command="{Binding DeleteBranchCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </TabViewItem>
                    <TabViewItem Header="Remotes" IsClosable="False">
                        <StackPanel Padding="6" Spacing="6">
                            <ListView ItemsSource="{Binding Remotes}" Height="180">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{Binding FetchUrl}" Opacity="0.7" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Add" Command="{Binding AddRemoteCommand}" />
                                <Button Content="Remove" Command="{Binding RemoveRemoteCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </TabViewItem>
                    <TabViewItem Header="Stashes" IsClosable="False">
                        <StackPanel Padding="6" Spacing="6">
                            <ListView ItemsSource="{Binding Stashes}" Height="180" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Stash" Command="{Binding StashCreateCommand}" />
                                <Button Content="Apply" Command="{Binding StashApplyCommand}" />
                                <Button Content="Drop" Command="{Binding StashDropCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </TabViewItem>
                    <TabViewItem Header="Tags" IsClosable="False">
                        <StackPanel Padding="6" Spacing="6">
                            <ListView ItemsSource="{Binding Tags}" Height="180" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Create" Command="{Binding TagCreateCommand}" />
                                <Button Content="Push" Command="{Binding TagPushCommand}" />
                                <Button Content="Delete" Command="{Binding TagDeleteCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </TabViewItem>
                    <TabViewItem Header="Log" IsClosable="False">
                        <ListView ItemsSource="{Binding LogEntries}" Height="240">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Message}" />
                                        <TextBlock Text="{Binding Author}" Opacity="0.7" FontSize="12" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </TabViewItem>
                </TabView>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
            <ProgressBar IsIndeterminate="{Binding IsBusy}" Width="200" Value="{Binding ProgressValue}" Maximum="100" />
            <TextBlock Text="{Binding StatusBanner}" Opacity="0.72" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
