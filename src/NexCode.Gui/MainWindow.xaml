<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="NexCode.Gui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:NexCode.Gui"
    xmlns:controls="using:NexCode.Gui.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="NexCode"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar (content is extended into the title bar). The back button
             lives outside the drag region so it stays clickable; the rest is draggable. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="BackButton"
                Grid.Column="0"
                Width="40"
                Height="32"
                Margin="6,0,0,0"
                Padding="0"
                VerticalAlignment="Center"
                AutomationProperties.Name="Back to chat"
                Background="Transparent"
                BorderThickness="0"
                Click="BackButton_Click"
                ToolTipService.ToolTip="Back to chat"
                Visibility="Collapsed">
                <FontIcon FontSize="14" Glyph="&#xE72B;" />
            </Button>
            <Border x:Name="TitleBarDragRegion" Grid.Column="1" Background="Transparent">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center">
                    <Image
                        Width="18"
                        Height="18"
                        Margin="8,0,0,0"
                        Source="ms-appx:///Assets/AppIcon.ico" />
                    <TextBlock
                        x:Name="AppTitleTextBlock"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="NexCode" />
                </StackPanel>
            </Border>
        </Grid>

        <Frame x:Name="ShellFrame" Grid.Row="1" />

        <controls:AuthGateOverlay
            x:Name="AuthGate"
            Grid.Row="0"
            Grid.RowSpan="2"
            Visibility="Collapsed" />

        <controls:SubscriptionGateSheet
            x:Name="SubscriptionGate"
            Grid.Row="0"
            Grid.RowSpan="2"
            VerticalAlignment="Bottom"
            Visibility="Collapsed" />
    </Grid>
</Window>
