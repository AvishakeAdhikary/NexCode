<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="NexCode.Gui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:NexCode.Gui"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="NexCode"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Padding="20,14"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon
                    FontSize="18"
                    Glyph="&#xE943;" />
                <StackPanel>
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="NexCode" />
                    <TextBlock
                        Opacity="0.72"
                        Text="Spec-anchored foundation shell" />
                </StackPanel>
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="10">
                <Border
                    Padding="10,6"
                    Background="{ThemeResource AccentFillColorSecondaryBrush}"
                    CornerRadius="999">
                    <StackPanel>
                        <TextBlock
                            x:Name="AccountStatusTextBlock"
                            FontWeight="SemiBold"
                            Text="Auth: unknown" />
                        <TextBlock
                            x:Name="SubscriptionStatusTextBlock"
                            Opacity="0.82"
                            Text="Tier: unknown" />
                    </StackPanel>
                </Border>
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="Helper" />
                <TextBlock
                    x:Name="HelperStatusTextBlock"
                    VerticalAlignment="Center"
                    Text="Not checked" />
                <ProgressRing
                    x:Name="HelperProgressRing"
                    Width="20"
                    Height="20"
                    IsActive="False" />
                <Button
                    Click="PingHelperButton_Click"
                    Content="Ping Helper" />
            </StackPanel>
        </Grid>

        <Grid
            x:Name="NavView"
            Grid.Row="1"
            ColumnSpacing="12"
            Padding="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="16">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="4">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="Projects" />
                        <TextBlock
                            Opacity="0.72"
                            Text="Section 4.3 Column A" />
                    </StackPanel>

                    <Button
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        Content="New Chat" />

                    <StackPanel
                        Grid.Row="2"
                        Margin="0,8,0,0"
                        Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="Workspace" />
                        <ListView Height="200">
                            <ListViewItem Content="NexCode (active spec workspace)" />
                        </ListView>
                        <TextBlock FontWeight="SemiBold" Text="Navigation" />
                        <Button Content="Search" HorizontalAlignment="Stretch" />
                        <Button Content="Plugins" HorizontalAlignment="Stretch" />
                        <Button Content="Automations" HorizontalAlignment="Stretch" />
                        <Button Content="History" HorizontalAlignment="Stretch" />
                        <Button Content="Memories" HorizontalAlignment="Stretch" />
                        <Button Content="Plans" HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <Button
                        Grid.Row="3"
                        HorizontalAlignment="Stretch"
                        Content="Settings" />
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="16">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ComboBox SelectedIndex="0">
                            <ComboBoxItem Content="Code" />
                            <ComboBoxItem Content="Plan" />
                            <ComboBoxItem Content="Debug" />
                            <ComboBoxItem Content="Ask" />
                        </ComboBox>
                        <ComboBox Grid.Column="1" SelectedIndex="0">
                            <ComboBoxItem Content="Default" />
                            <ComboBoxItem Content="Detailed" />
                            <ComboBoxItem Content="Mentor" />
                        </ComboBox>
                        <ComboBox Grid.Column="2" SelectedIndex="0">
                            <ComboBoxItem Content="gpt-4.1" />
                            <ComboBoxItem Content="claude-opus-4" />
                            <ComboBoxItem Content="gemini-2.5-pro" />
                        </ComboBox>
                        <ComboBox Grid.Column="3" SelectedIndex="0">
                            <ComboBoxItem Content="Local" />
                            <ComboBoxItem Content="Remote" />
                            <ComboBoxItem Content="Cloud" />
                        </ComboBox>
                        <ToggleSwitch Grid.Column="4" Header="Sandbox" />
                    </Grid>

                    <Border
                        Grid.Row="1"
                        Padding="12"
                        Background="{ThemeResource LayerFillColorAltBrush}"
                        CornerRadius="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock FontWeight="SemiBold" Text="Plan/Todo Status" />
                            <TextBlock Text="No active plan yet" />
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Row="2"
                        Padding="16"
                        Background="{ThemeResource LayerFillColorAltBrush}"
                        CornerRadius="12">
                        <StackPanel Spacing="10">
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="Session Panel" />
                            <TextBlock Text="This center column is the phase-one shell for the virtualized message stream, streamed tool output, and plan-aware chat workflow from Sections 4, 5, 10, and 11." TextWrapping="Wrap" />
                            <TextBlock Text="Next slices will replace this placeholder with the real session feed and IPC-driven state." TextWrapping="Wrap" Opacity="0.72" />
                        </StackPanel>
                    </Border>

                    <Grid
                        Grid.Row="3"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            AcceptsReturn="True"
                            MinHeight="88"
                            PlaceholderText="Send a message to NexCode..." />
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            Spacing="8">
                            <Button Content="Send" />
                            <Button Content="Stop" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border
                Grid.Column="2"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Context Panel" />

                    <TabView Grid.Row="1" Margin="0,12,0,0">
                        <TabViewItem Header="Run">
                            <StackPanel Padding="12" Spacing="8">
                                <TextBlock FontWeight="SemiBold" Text="Run activity" />
                                <TextBlock
                                    x:Name="RunActivityStatusTextBlock"
                                    Text="Helper events will appear here as the live event stream foundation grows."
                                    TextWrapping="Wrap" />
                                <ListView
                                    x:Name="RunActivityListView"
                                    Height="420"
                                    SelectionMode="None" />
                            </StackPanel>
                        </TabViewItem>
                        <TabViewItem Header="Account">
                            <StackPanel Padding="12" Spacing="10">
                                <TextBlock FontWeight="SemiBold" Text="Authentication and subscription" />
                                <TextBlock Text="This slice wires durable account state, Microsoft sign-in readiness, and Microsoft Store subscription verification into the GUI foundation." TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        x:Name="SignInButton"
                                        Click="SignInButton_Click"
                                        HorizontalAlignment="Left"
                                        Content="Sign in with Microsoft" />
                                    <Button
                                        x:Name="RestorePurchasesButton"
                                        Click="RefreshSubscriptionButton_Click"
                                        HorizontalAlignment="Left"
                                        Content="Restore purchases" />
                                </StackPanel>
                                <TextBlock
                                    x:Name="AccountActionStatusTextBlock"
                                    Opacity="0.72"
                                    Text="Authentication actions will report status here."
                                    TextWrapping="Wrap" />
                                <Border
                                    Padding="12"
                                    Background="{ThemeResource LayerFillColorAltBrush}"
                                    CornerRadius="12">
                                    <StackPanel Spacing="6">
                                        <TextBlock FontWeight="SemiBold" Text="Identity" />
                                        <TextBlock x:Name="AccountDetailEmailTextBlock" Text="Email: unavailable" TextWrapping="Wrap" />
                                        <TextBlock x:Name="AccountDetailAuthTextBlock" Text="MSAL configuration: unknown" TextWrapping="Wrap" />
                                        <TextBlock x:Name="AccountDetailTokenTextBlock" Text="Token cache: unknown" TextWrapping="Wrap" />
                                        <TextBlock x:Name="AccountDetailTierTextBlock" Text="Subscription tier: unknown" TextWrapping="Wrap" />
                                        <TextBlock x:Name="AccountDetailProductsTextBlock" Text="Cached products: none" TextWrapping="Wrap" />
                                        <TextBlock x:Name="AccountDetailWarningTextBlock" Text="Subscription verification: none" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </TabViewItem>
                        <TabViewItem Header="Git">
                            <StackPanel Padding="12" Spacing="8">
                                <TextBlock FontWeight="SemiBold" Text="Git manager" />
                                <TextBlock Text="Foundation placeholder for status, branches, commits, and checkpoints." TextWrapping="Wrap" />
                            </StackPanel>
                        </TabViewItem>
                        <TabViewItem Header="Editor">
                            <StackPanel Padding="12" Spacing="8">
                                <TextBlock FontWeight="SemiBold" Text="Built-in editor" />
                                <TextBlock Text="Monaco and diff surfaces will be mounted here in a later slice." TextWrapping="Wrap" />
                            </StackPanel>
                        </TabViewItem>
                        <TabViewItem Header="Plans">
                            <StackPanel Padding="12" Spacing="8">
                                <TextBlock FontWeight="SemiBold" Text="Plans workspace" />
                                <TextBlock Text="The plan-first workflow will live here once the Section 10 system is wired." TextWrapping="Wrap" />
                            </StackPanel>
                        </TabViewItem>
                    </TabView>
                </Grid>
            </Border>
        </Grid>

        <Border
            x:Name="AuthGateOverlay"
            Grid.RowSpan="2"
            Background="#B3181A1F"
            Visibility="Collapsed">
            <Grid>
                <Border
                    Width="640"
                    MaxWidth="640"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="24">
                    <StackPanel Spacing="16">
                        <TextBlock
                            x:Name="AuthGateTitleTextBlock"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Text="Microsoft sign-in required" />
                        <TextBlock
                            x:Name="AuthGateBodyTextBlock"
                            Opacity="0.82"
                            Text="The helper must complete authentication before the main dashboard unlocks."
                            TextWrapping="Wrap" />
                        <Border
                            Padding="14"
                            Background="{ThemeResource LayerFillColorAltBrush}"
                            CornerRadius="14">
                            <StackPanel Spacing="6">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="Authentication status" />
                                <TextBlock
                                    x:Name="AuthGateStatusTextBlock"
                                    Text="Waiting for helper state..."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border
                            Padding="14"
                            Background="{ThemeResource LayerFillColorAltBrush}"
                            CornerRadius="14">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ProgressRing
                                    x:Name="AuthGateEventStreamProgressRing"
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Top"
                                    IsActive="False" />

                                <StackPanel
                                    Grid.Column="1"
                                    Spacing="6">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="Helper event stream" />
                                    <TextBlock
                                        x:Name="AuthGatePollStatusTextBlock"
                                        Text="Connecting to the helper event stream..."
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="AuthGateEventDetailTextBlock"
                                        Opacity="0.72"
                                        Text="The helper will push authentication changes here as they happen."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="12">
                            <Button
                                x:Name="AuthGateSignInButton"
                                Click="SignInButton_Click"
                                Content="Sign in with Microsoft" />
                            <Button
                                Click="PingHelperButton_Click"
                                Content="Refresh now" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
