<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="NexCode.Gui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:NexCode.Gui"
    xmlns:controls="using:NexCode.Gui.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="NexCode"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar drag region (content is extended into the title bar). -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="40"
            Background="Transparent"
            ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image
                Grid.Column="0"
                Width="18"
                Height="18"
                Margin="14,0,0,0"
                VerticalAlignment="Center"
                Source="ms-appx:///Assets/AppIcon.ico" />
            <TextBlock
                x:Name="AppTitleTextBlock"
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="NexCode" />
        </Grid>

        <Frame x:Name="ShellFrame" Grid.Row="1" />

        <controls:AuthGateOverlay
            x:Name="AuthGate"
            Grid.Row="0"
            Grid.RowSpan="2"
            Visibility="Collapsed" />

        <controls:SubscriptionGateSheet
            x:Name="SubscriptionGate"
            Grid.Row="0"
            Grid.RowSpan="2"
            VerticalAlignment="Bottom"
            Visibility="Collapsed" />
    </Grid>
</Window>
