<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>13</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Protobuf Include="..\NexCode.Remote\Protos\nexcode_remote.proto" GrpcServices="Client" Link="Protos\nexcode_remote.proto" />
    <Compile Include="..\NexCode.Remote\Security\X25519.cs" Link="Remote\Security\X25519.cs" />
    <Compile Include="..\NexCode.Remote\Security\EcdhAesGcmCipher.cs" Link="Remote\Security\EcdhAesGcmCipher.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.*" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.*" />
    <PackageReference Include="Microsoft.Identity.Client" Version="*" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.*" />
    <PackageReference Include="LibGit2Sharp" Version="0.*" />
    <PackageReference Include="Cronos" Version="0.*" />
    <PackageReference Include="Grpc.Net.Client" Version="2.*" />
    <PackageReference Include="Grpc.Tools" Version="2.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Google.Protobuf" Version="3.*" />
    <PackageReference Include="BouncyCastle.NetCore" Version="1.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NexCode.Data\NexCode.Data.csproj" />
    <ProjectReference Include="..\NexCode.Shared\NexCode.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Marketplace\Fixtures\catalog.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!--
      appsettings.Local.json is gitignored. When a developer creates one locally, MSBuild
      copies it into bin/ so the Host.CreateApplicationBuilder pipeline picks it up at runtime.
      The Condition prevents the build from failing when the file is absent (which is the
      default state in CI / fresh clones).
    -->
    <None Include="appsettings.Local.json" Condition="Exists('appsettings.Local.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
